:host {
  display: flex;
  width: 100%;
  min-height: 0;
  flex: 1 1 0;
  overflow: hidden;
}

.tab-panel {
  display: flex;
  width: 100%;
  min-height: 0;
  flex: 1 1 0;
  flex-direction: column;
  overflow: hidden;
}

.analysis-scroll {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex: 1 1 0;
  position: relative;
  z-index: 1;
  overflow: hidden;
  contain: paint;
  -webkit-overflow-scrolling: touch;
}

.page-content {
  width: 100%;
  min-height: 100%;
  padding-bottom: 24px;
}

/* Keep same-context chart hosts mounted during refresh, without exposing the old view. */
.analysis-content.is-analysis-hidden {
  visibility: hidden;
  pointer-events: none;
}

.analysis-header {
  position: relative;
  z-index: var(--tl-z-sticky);
  padding: 12rpx var(--tl-page-inline) 16rpx;
  background: var(--tl-color-page);
  transform: translateZ(0);
  -webkit-transform: translateZ(0);
  will-change: transform;
}

.analysis-primary-tabs {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin-bottom: var(--tl-space-md);
}

.analysis-primary-tab {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: var(--tl-space-sm) 8rpx;
  border-bottom: 4rpx solid transparent;
  color: var(--tl-color-text-secondary);
  font-weight: var(--tl-font-weight-bold);
  font-size: var(--tl-font-size-sm);
  flex: 1;
  text-align: center;
}

.analysis-primary-tab.is-active {
  border-bottom-color: var(--tl-color-primary);
  color: var(--tl-color-primary);
}

.context-nav.is-disabled {
  opacity: 0.35;
}

.custom-range {
  margin-bottom: 20rpx;
  padding: 24rpx;
}

.custom-range__dates {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
  color: var(--tl-color-text);
}

.custom-range__note {
  display: block;
  margin-top: 14rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

.custom-context-bar {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: var(--tl-space-sm);
}

.date-preset-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.preset-pill {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
  background: var(--tl-color-surface);
  border-radius: var(--tl-radius-pill);
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-medium);
  transition: all var(--tl-duration-fast) ease;
}

.preset-pill.is-active {
  background: var(--tl-color-primary-soft);
  color: var(--tl-color-primary);
  font-weight: var(--tl-font-weight-bold);
}

.range-selector-box {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: var(--tl-color-surface);
  padding: 12rpx 20rpx;
  border-radius: var(--tl-radius-md);
}

.range-picker-item {
  flex: 1;
  text-align: center;
}

.range-picker-val {
  font-size: var(--tl-font-caption);
  color: var(--tl-color-text);
  font-weight: var(--tl-font-weight-medium);
}

.range-separator {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

.range-days-tag {
  font-size: var(--tl-font-caption-compact);
  color: var(--tl-color-primary);
  background: var(--tl-color-primary-soft);
  padding: 4rpx 12rpx;
  border-radius: var(--tl-radius-pill);
  white-space: nowrap;
}

/* 原生微柱状图卡片 */
.chart-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--tl-space-md);
}

.chart-card-title {
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  color: var(--tl-color-text);
}

.chart-legend-box {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--tl-font-caption);
  color: var(--tl-color-text-secondary);
}

.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.legend-dot.is-income {
  background: var(--tl-color-income);
}

.legend-dot.is-expense {
  background: var(--tl-color-primary);
}

.native-bar-scroll {
  width: 100%;
  white-space: nowrap;
  padding-bottom: 8rpx;
}

.native-bar-container {
  display: inline-flex;
  align-items: flex-end;
  gap: 16rpx;
  min-width: 100%;
  height: 220rpx;
  padding: 0 10rpx 10rpx;
  border-bottom: 1rpx solid var(--tl-color-border);
}

.bar-col {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  min-width: 44rpx;
  height: 100%;
  justify-content: flex-end;
  padding: 4rpx;
  border-radius: var(--tl-radius-sm);
  transition: background var(--tl-duration-fast) ease;
}

.bar-col.is-selected {
  background: var(--tl-color-primary-soft);
}

.bar-pair {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 170rpx;
  width: 100%;
  justify-content: center;
}

.bar-stem {
  width: 12rpx;
  min-height: 4rpx;
  border-radius: var(--tl-radius-xs) var(--tl-radius-xs) 0 0;
  transition: height var(--tl-duration-fast) ease;
}

.bar-stem.is-income {
  background: var(--tl-color-income);
}

.bar-stem.is-expense {
  background: var(--tl-color-primary);
}

.bar-x-label {
  margin-top: 8rpx;
  font-size: var(--tl-font-caption-compact);
  color: var(--tl-color-text-tertiary);
  white-space: nowrap;
}

/* 结构化趋势明细 */
.timeline-detail-box {
  margin-top: var(--tl-space-md);
  padding-top: var(--tl-space-md);
  border-top: 1rpx solid var(--tl-color-border-subtle);
}

.timeline-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--tl-space-sm);
}

.timeline-title {
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  color: var(--tl-color-text);
}

.timeline-cols-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 440rpx;
  justify-content: flex-end;
}

.th-cell {
  flex: 1;
  text-align: right;
  font-size: var(--tl-font-caption);
  color: var(--tl-color-text-tertiary);
}

.timeline-table {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.timeline-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 10rpx;
  border-radius: var(--tl-radius-md);
  background: var(--tl-color-page);
  transition: background var(--tl-duration-fast) ease;
}

.timeline-row.is-active-row {
  background: var(--tl-color-primary-soft);
}

.date-badge-box {
  flex: 0 0 108rpx;
}

.date-badge {
  display: inline-block;
  padding: 4rpx 10rpx;
  background: var(--tl-color-surface);
  border-radius: var(--tl-radius-sm);
  font-size: var(--tl-font-caption);
  color: var(--tl-color-text-secondary);
  font-weight: var(--tl-font-weight-medium);
  white-space: nowrap;
}

.timeline-data-grid {
  display: flex;
  align-items: center;
  gap: 12rpx;
  width: 440rpx;
  justify-content: flex-end;
}

.val-cell {
  flex: 1;
  text-align: right;
  font-size: var(--tl-font-caption);
  white-space: nowrap;
}

.val-cell.val-inc.has-val {
  color: var(--tl-color-income);
}

.val-cell.val-exp.has-val {
  color: var(--tl-color-primary);
}

.val-cell.is-zero {
  color: var(--tl-color-text-tertiary);
}

.val-cell.val-bal {
  font-weight: var(--tl-font-weight-bold);
}

.val-cell.val-bal.is-surplus {
  color: var(--tl-color-text);
}

.val-cell.val-bal.is-deficit {
  color: var(--tl-color-primary);
}

.ledger-name {
  overflow: hidden;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chart-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-kicker {
  color: var(--tl-color-warning);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  letter-spacing: 3rpx;
}

.card-title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}

.chart-caption {
  padding: 4rpx 12rpx;
  border-radius: var(--tl-radius-pill);
  color: var(--tl-color-primary);
  background: var(--tl-color-primary-soft);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.chart-card {
  margin-top: 20rpx;
  padding: 28rpx;
}

.chart-tabs {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 8rpx;
}

.chart-tab {
  flex: 0 0 auto;
  padding: 15rpx 22rpx;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-primary-soft);
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.chart-tab.is-active {
  color: var(--tl-color-text-inverse);
  background: var(--tl-color-text);
}

.chart-card {
  margin-top: 0;
}

.chart-heading {
  align-items: flex-start;
}

.analysis-chart-canvas {
  position: relative;
  display: flex;
  width: 100%;
  height: 360rpx;
  margin-top: 18rpx;
  flex-direction: column;
  overflow: hidden;
  contain: paint;
  border-radius: var(--tl-radius-md);
  transition: opacity 0.15s ease;
}

.analysis-chart-canvas.is-chart-hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

#analysis-chart {
  display: block;
  width: 100%;
  height: 360rpx;
}

.chart-card {
  margin-top: 0;
}

.analysis-context-bar {
  display: flex;
  width: 100%;
  height: 76rpx;
  align-items: center;
  border: var(--tl-border-width) solid var(--tl-color-border-subtle);
  border-radius: var(--tl-radius-pill);
  background: var(--tl-palette-white, #ffffff);
  box-shadow: var(--tl-shadow-sm);
  overflow: hidden;
}

.context-period {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: space-between;
}

.context-period.is-static {
  justify-content: center;
  padding: 0 20rpx;
}

.context-picker {
  display: flex;
  flex: 1 1 auto;
  height: 100%;
  min-width: 0;
  align-items: center;
  justify-content: center;
}

.context-picker-btn {
  display: flex;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.context-period-text {
  overflow: hidden;
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.context-nav {
  display: flex;
  width: 88rpx;
  height: 76rpx;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  color: var(--tl-color-primary);
  font-size: var(--tl-font-data);
  font-weight: var(--tl-font-weight-bold);
  cursor: pointer;
}

.context-nav:active {
  background: var(--tl-color-primary-soft);
}

.analysis-mode-sheet {
  padding: 8rpx 28rpx 28rpx;
}

.analysis-mode-sheet__title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}

.analysis-mode-list {
  margin-top: 20rpx;
  border-top: 1rpx solid var(--tl-color-divider);
}

.analysis-mode-option {
  display: flex;
  min-height: 100rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--tl-color-divider);
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}

.analysis-mode-option:last-child {
  border-bottom: none;
}

.analysis-mode-option.is-active {
  color: var(--tl-color-primary);
}

.calendar-card {
  margin-top: 0;
  padding: 16rpx 18rpx 18rpx;
}

.calendar-weekdays,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.calendar-weekdays {
  margin-bottom: 8rpx;
  padding: 10rpx 2rpx;
  border-radius: var(--tl-radius-xs);
  background: var(--tl-color-surface-muted);
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  text-align: center;
}

.calendar-cell {
  display: flex;
  min-width: 0;
  min-height: 112rpx;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 2rpx 6rpx;
  border: 1rpx solid transparent;
  border-radius: var(--tl-radius-xs);
}

.calendar-cell.is-striped {
  background: var(--tl-palette-warm-100);
}

.calendar-cell.is-active {
  border-color: var(--tl-color-primary);
  background: var(--tl-color-primary-soft);
}

.calendar-cell.is-today .calendar-day {
  color: var(--tl-color-primary);
}

.calendar-cell.is-blank {
  pointer-events: none;
}

.calendar-day {
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.calendar-money {
  display: flex;
  width: 100%;
  min-width: 0;
  flex-direction: column;
  gap: 3rpx;
  margin-top: 7rpx;
  text-align: center;
}

.calendar-income,
.calendar-expense {
  overflow: hidden;
  font-size: var(--tl-font-caption-compact);
  font-weight: var(--tl-font-weight-bold);
  letter-spacing: -0.4rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.calendar-income {
  color: var(--tl-color-income);
}

.calendar-expense {
  color: var(--tl-color-expense);
}

.calendar-record-empty {
  margin-top: 0;
  padding: 46rpx 28rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  text-align: center;
}

.showcase-insights {
  margin-top: 20rpx;
  padding: 28rpx;
}

.showcase-section {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
  margin: 38rpx 4rpx 14rpx;
}

.showcase-insight {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 15rpx 0;
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.55;
}

.showcase-insight + .showcase-insight {
  border-top: 1rpx solid var(--tl-color-divider);
}

.insight-label {
  flex: 0 0 auto;
  padding: 5rpx 10rpx;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-surface-muted);
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-caption-compact);
}

.insight-label.warning {
  background: var(--tl-color-primary-soft);
  color: var(--tl-color-primary);
}

.is-income {
  color: var(--tl-color-income) !important;
}

.is-expense {
  color: var(--tl-color-expense) !important;
}

#month-category-chart,
#month-budget-chart,
#year-category-chart,
#calendar-week-chart,
#all-category-chart {
  display: block;
  width: 100%;
  height: 300rpx;
}

.analysis-summary-card {
  padding: 30rpx;
  background: var(--tl-color-primary-soft);
}

.summary-eyebrow,
.summary-metrics,
.calendar-list-head,
.calendar-day-total,
.analysis-record-row,
.category-ranking-row,
.calendar-detail-row {
  display: flex;
  align-items: center;
}

.summary-eyebrow,
.calendar-list-head {
  justify-content: space-between;
}

.summary-title {
  display: block;
  margin-top: 24rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.45;
}

.summary-copy {
  display: block;
  margin-top: 12rpx;
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  line-height: 1.65;
}

.summary-metrics {
  gap: 12rpx;
  margin-top: 26rpx;
}

.summary-metric {
  min-width: 0;
  flex: 1;
  padding: 18rpx 12rpx;
  border-radius: var(--tl-radius-control);
  background: rgba(255, 255, 255, 0.76);
  text-align: center;
}

.summary-metric text {
  display: block;
  overflow: hidden;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-metric text:last-child {
  margin-top: 8rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.analysis-record-list,
.category-ranking,
.calendar-detail-list {
  padding: 0 28rpx;
}

.analysis-record-row,
.calendar-detail-row {
  min-height: 112rpx;
  gap: 18rpx;
  border-bottom: 1rpx solid var(--tl-color-divider);
}

.analysis-record-row:last-child,
.category-ranking-row:last-child,
.calendar-detail-row:last-child {
  border-bottom: none;
}

.category-index {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--tl-color-surface-muted);
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.category-ranking-row:nth-child(1) .category-index {
  background: var(--tl-color-chip-amber);
  color: var(--tl-color-warning);
}

.category-ranking-row:nth-child(2) .category-index {
  background: var(--tl-color-surface-soft);
  color: var(--tl-color-text-secondary);
}

.category-ranking-row:nth-child(3) .category-index {
  background: var(--tl-color-chip-orange);
  color: var(--tl-color-primary);
}

.category-main {
  min-width: 0;
  flex: 1;
}

.category-main text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-main text:first-child {
  color: var(--tl-color-text);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.category-main text:last-child {
  margin-top: 7rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

.record-amount {
  flex: 0 0 auto;
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}

.category-ranking-row {
  min-height: 108rpx;
  gap: 18rpx;
  border-bottom: 1rpx solid var(--tl-color-divider);
}

.change-badge {
  flex: 0 0 auto;
  padding: 7rpx 12rpx;
  border-radius: var(--tl-radius-pill);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.change-badge.is-up {
  color: var(--tl-color-expense);
  background: var(--tl-color-primary-soft);
}

.change-badge.is-down {
  color: var(--tl-color-income);
  background: var(--tl-color-income-soft);
}

.change-badge.is-flat {
  color: var(--tl-color-text-tertiary);
  background: var(--tl-color-surface-muted);
}

.calendar-first-head {
  margin-top: 8rpx;
}

.calendar-list-head {
  gap: 18rpx;
  margin: 36rpx 4rpx 14rpx;
}

.calendar-list-head > view:first-child {
  min-width: 0;
}

.calendar-list-count {
  display: block;
  margin-top: 6rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

.calendar-day-total {
  flex: 0 0 auto;
  gap: 14rpx;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

#month-ratio-chart,
#year-cashflow-chart,
#year-balance-chart {
  display: block;
  width: 100%;
  height: 100%;
}

.analysis-summary-card .summary-title {
  font-size: var(--tl-font-data-lg);
  letter-spacing: -2rpx;
}

.analysis-summary-card .summary-metric:nth-child(3) {
