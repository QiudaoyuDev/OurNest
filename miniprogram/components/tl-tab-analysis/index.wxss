}

.ranking-toggle__item {
  min-width: 64rpx;
  padding: 8rpx 14rpx;
  border-radius: var(--tl-radius-pill);
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.3;
  text-align: center;
}

.ranking-toggle__item.is-active {
  background: var(--tl-color-surface);
  color: var(--tl-color-primary);
}

.section-title-with-help {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-help-trigger {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
}

.analysis-question-dialog {
  padding: 32rpx;
}

.analysis-question-dialog__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.analysis-question-dialog__title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}

.analysis-question-dialog__close {
  display: flex;
  width: 56rpx;
