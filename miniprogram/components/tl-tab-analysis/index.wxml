<template name="ratio-section">
  <view wx:if="{{ratioSelection}}" class="ratio-preview card">
    <view class="ratio-preview-heading">
      <text class="card-title">{{ratioSelection.name}}明细</text>
      <text wx:if="{{ratioSelection.parentCategory}}" class="ratio-preview-meta">{{ratioSelection.parentCategory}}</text>
      <text class="ratio-preview-meta">{{ratioPreviewRangeLabel}}</text>
    </view>
    <tl-skeleton wx:if="{{ratioPreviewStatus === 'loading'}}" variant="list">
    </tl-skeleton>
    <tl-empty-state wx:elif="{{ratioPreviewStatus === 'error'}}" variant="error" title="{{ratioPreviewStale ? '分析数据需要刷新' : '明细加载失败'}}" description="{{ratioPreviewError}}">
      <tl-button wx:if="{{ratioPreviewStale}}" variant="secondary" size="small" bind:tap="refreshRatioAnalysis">刷新分析</tl-button>
      <tl-button wx:else variant="secondary" size="small" bind:tap="retryRatioPreview">重新加载</tl-button>
    </tl-empty-state>
    <block wx:elif="{{ratioPreviewStatus === 'ready' || ratioPreviewStatus === 'empty'}}">
      <view class="ratio-preview-summary">
        <text class="is-expense">合计 ¥{{ratioPreviewAmountText}}</text>
        <text>共 {{ratioPreviewCount}} 笔</text>
      </view>
      <tl-empty-state wx:if="{{ratioPreviewStatus === 'empty'}}" title="本期该分类暂无支出" description="可以选择其他分类查看明细">
      </tl-empty-state>
      <block wx:else>
        <text class="ratio-preview-meta">最近 {{ratioPreviewRecords.length}} 笔</text>
        <view wx:for="{{ratioPreviewRecords}}" wx:key="id" class="ratio-preview-record">
          <view class="ratio-preview-record-main">
            <text class="ratio-preview-record-title">{{item.note || item.categoryName || '其他'}}</text>
            <text class="ratio-preview-meta">{{item.date}} · {{item.account || '未设置账户'}}</text>
          </view>
          <text class="record-amount expense">-¥{{item.amountText}}</text>
        </view>
      </block>
      <tl-button variant="text" size="small" bind:tap="openRatioRecords">查看全部 {{ratioPreviewCount}} 笔明细</tl-button>
    </block>
  </view>
  <view wx:elif="{{activeRanking.length}}" class="ratio-preview-hint">点选扇区或分类，查看最近 3 笔支出</view>
  <tl-empty-state wx:else title="本期暂无支出分类" description="可以选择其他时间范围查看">
  </tl-empty-state>
  <view wx:if="{{activeRanking.length}}" class="analysis-ratio-list">
    <view wx:for="{{activeRanking}}" wx:key="key" class="analysis-ratio-row {{ratioSelection && ratioSelection.key === item.key ? 'is-selected' : ''}}" data-key="{{item.key}}" bindtap="selectRatioCategory">
      <view class="ratio-category-main">
        <text>{{item.name}}</text>
        <text wx:if="{{item.parentCategory}}" class="ratio-preview-meta">{{item.parentCategory}}</text>
      </view>
      <view class="ratio-category-amount">
        <text>¥{{item.amountText}} · {{item.rate}}%</text>
        <tl-icon wx:if="{{ratioSelection && ratioSelection.key === item.key}}" name="check-line" size="26" colorKey="primary">
        </tl-icon>
      </view>
    </view>
  </view>
</template>
<view class="tab-panel analysis-page">
  <scroll-view class="analysis-scroll" scroll-y="{{true}}" enhanced="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
    <view class="page-content">
      <view class="analysis-header fade-up">
        <view class="analysis-context-bar">
          <view class="context-ledger" bindtap="switchLedger">
            <text class="ledger-name">{{ledgerName}}</text>
            <tl-icon name="arrow-down-s-line" size="24" colorKey="primary">
            </tl-icon>
          </view>
          <view class="context-divider">
          </view>
          <view wx:if="{{mode !== 'all' && mode !== 'custom'}}" class="context-period">
            <view class="context-nav" data-delta="-1" bindtap="shift">
              <tl-icon name="arrow-left-s-line" size="28" colorKey="primary">
              </tl-icon>
            </view>
            <text class="context-period-text">{{rangeLabel}}</text>
            <view class="context-nav" data-delta="1" bindtap="shift">
              <tl-icon name="arrow-right-s-line" size="28" colorKey="primary">
              </tl-icon>
            </view>
          </view>
          <view wx:else class="context-period is-static">
            <text class="context-period-text">{{rangeLabel}}</text>
          </view>
          <view class="context-divider">
          </view>
          <view class="context-mode-picker" bindtap="openModeSheet">
            <view class="context-mode">
              <text>{{modeLabel}}</text>
              <tl-icon name="arrow-down-s-line" size="24" colorKey="primary">
              </tl-icon>
            </view>
          </view>
        </view>
      </view>
      <tl-skeleton wx:if="{{loading}}" variant="analysis">
      </tl-skeleton>
      <tl-empty-state wx:elif="{{error}}" variant="error" title="分析数据加载失败" description="请检查网络后重新加载">
      </tl-empty-state>
      <tl-empty-state wx:elif="{{noLedger}}" title="还没有可分析的账本" description="创建账本并记下第一笔收支后，这里会生成分析">
      </tl-empty-state>
      <block wx:else>
        <block wx:if="{{mode === 'month'}}">
          <view class="analysis-summary-card card fade-up">
            <view class="summary-eyebrow">
              <text class="section-kicker">本月结余</text>
            </view>
            <text class="summary-title">¥{{overview.balanceText}}</text>
            <text class="summary-copy">{{overview.saveRateText}} {{balanceComparisonText}}</text>
            <view class="summary-metrics">
              <view class="summary-metric">
                <text>收入</text>
                <text class="is-income">¥{{overview.incomeText}}</text>
              </view>
              <view class="summary-metric">
                <text>支出</text>
                <text class="is-expense">¥{{overview.expenseText}}</text>
              </view>
            </view>
          </view>
          <view class="showcase-section fade-up">
            <text class="section-kicker">本月关注</text>
          </view>
          <view class="showcase-insights card fade-up">
            <view wx:for="{{insights}}" wx:key="*this" class="showcase-insight">
              <text class="insight-label neutral">提示</text>
              <text>{{item}}</text>
            </view>
          </view>
          <view class="showcase-section fade-up">
            <view class="section-title-with-help">
              <text class="section-kicker">图表分析</text>
              <view class="section-help-trigger" data-question="month-chart" bindtap="openQuestionDialog">
                <tl-icon name="question-line" size="28" colorKey="warning">
                </tl-icon>
              </view>
            </view>
          </view>
          <scroll-view class="analysis-chart-switcher fade-up" scroll-x="{{true}}" show-scrollbar="{{false}}">
            <view class="chart-tabs">
              <view class="chart-tab {{activeChart === 'monthTrend' ? 'is-active' : ''}}" data-chart="monthTrend" bindtap="switchChart">消费走势</view>
              <view class="chart-tab {{activeChart === 'monthRatio' ? 'is-active' : ''}}" data-chart="monthRatio" bindtap="switchChart">支出占比</view>
            </view>
          </scroll-view>
          <view class="chart-card card">
            <view class="chart-heading">
              <text class="card-title">{{chartTitle}}</text>
              <text wx:if="{{activeChart === 'monthTrend' && trendCaption}}" class="chart-caption">{{trendCaption}}</text>
            </view>
            <view class="analysis-chart-canvas">
              <ec-canvas id="analysis-chart" canvas-id="analysis-chart" ec="{{ec}}" bind:init="onChartInit" bind:initerror="onChartInitError" force-use-old-canvas="true">
              </ec-canvas>
            </view>
          </view>
          <template wx:if="{{activeChart === 'monthRatio'}}" is="ratio-section" data="{{ratioSelection, ratioPreviewStatus, ratioPreviewRecords, ratioPreviewAmountText, ratioPreviewCount, ratioPreviewRangeLabel, ratioPreviewStale, ratioPreviewError, activeRanking}}">
          </template>
          <view class="showcase-section fade-up">
            <view class="section-title-with-help">
              <text class="section-kicker">本月消费 Top 5</text>
              <view class="section-help-trigger" data-question="month-top" bindtap="openQuestionDialog">
                <tl-icon name="question-line" size="28" colorKey="warning">
                </tl-icon>
              </view>
            </view>
          </view>
          <view class="analysis-record-list card fade-up">
            <view wx:for="{{monthlyTopRecords}}" wx:key="index" class="record-row analysis-record-row">
              <view class="category-mark expense">
                <tl-icon name="{{item.categoryIcon}}" size="32" colorKey="primary">
                </tl-icon>
              </view>
              <view class="record-main">
                <view class="record-line">
                  <text class="record-title">{{item.categoryText}}</text>
                  <text class="record-amount expense">-¥{{item.amountText}}</text>
                </view>
                <view class="record-line record-subline">
                  <text class="record-meta">{{item.account}} · {{item.timeText}}</text>
                </view>
                <text class="record-note">{{item.noteText}}</text>
              </view>
            </view>
          </view>
        </block>
        <block wx:elif="{{mode === 'year'}}">
          <view class="analysis-summary-card card fade-up">
            <text class="section-kicker">{{rangeLabel}}</text>
            <text class="summary-title">¥{{overview.balanceText}}</text>
            <text class="summary-copy">总收入 ¥{{overview.incomeText}} · 总支出 ¥{{overview.expenseText}} · {{overview.saveRateText}}</text>
          </view>
          <view class="showcase-section fade-up">
            <view class="section-title-with-help">
              <text class="section-kicker">图表分析</text>
              <view class="section-help-trigger" data-question="year-chart" bindtap="openQuestionDialog">
                <tl-icon name="question-line" size="28" colorKey="warning">
                </tl-icon>
              </view>
            </view>
          </view>
          <scroll-view class="analysis-chart-switcher fade-up" scroll-x="{{true}}" show-scrollbar="{{false}}">
            <view class="chart-tabs">
              <view class="chart-tab {{activeChart === 'yearCashflow' ? 'is-active' : ''}}" data-chart="yearCashflow" bindtap="switchChart">月度收支</view>
              <view class="chart-tab {{activeChart === 'yearBalance' ? 'is-active' : ''}}" data-chart="yearBalance" bindtap="switchChart">结余趋势</view>
              <view class="chart-tab {{activeChart === 'yearRatio' ? 'is-active' : ''}}" data-chart="yearRatio" bindtap="switchChart">支出占比</view>
            </view>
          </scroll-view>
          <view class="chart-card card">
            <view class="chart-heading">
              <text class="card-title">{{chartTitle}}</text>
              <text wx:if="{{activeChart === 'yearCashflow' && trendCaption}}" class="chart-caption">{{trendCaption}}</text>
            </view>
            <view class="analysis-chart-canvas">
              <ec-canvas id="analysis-chart" canvas-id="analysis-chart" ec="{{ec}}" bind:init="onChartInit" bind:initerror="onChartInitError" force-use-old-canvas="true">
              </ec-canvas>
            </view>
          </view>
          <template wx:if="{{activeChart === 'yearRatio'}}" is="ratio-section" data="{{ratioSelection, ratioPreviewStatus, ratioPreviewRecords, ratioPreviewAmountText, ratioPreviewCount, ratioPreviewRangeLabel, ratioPreviewStale, ratioPreviewError, activeRanking}}">
          </template>
          <view class="showcase-section fade-up">
            <view class="section-title-with-help">
              <text class="section-kicker">分类排名</text>
              <view class="section-help-trigger" data-question="year-ranking" bindtap="openQuestionDialog">
                <tl-icon name="question-line" size="28" colorKey="warning">
                </tl-icon>
              </view>
            </view>
            <view class="ranking-toggle">
              <text class="ranking-toggle__item {{yearRankingType === 'expense' ? 'is-active' : ''}}" data-type="expense" bindtap="switchYearRanking">支出</text>
              <text class="ranking-toggle__item {{yearRankingType === 'income' ? 'is-active' : ''}}" data-type="income" bindtap="switchYearRanking">收入</text>
            </view>
          </view>
          <view class="category-ranking card fade-up">
            <view wx:for="{{yearRankingRows}}" wx:key="key" class="category-ranking-row" data-index="{{index}}" data-source="year" bindtap="openCategoryRecords">
              <text class="category-index">{{item.rank}}</text>
              <view class="category-main">
                <text>{{item.name}}</text>
                <text>¥{{item.amountText}} · 占比 {{item.rate}}%</text>
              </view>
              <text class="change-badge is-flat">{{item.rate}}%</text>
            </view>
          </view>
        </block>
        <block wx:elif="{{mode === 'calendar'}}">
          <view class="showcase-section calendar-first-head fade-up">
            <text class="section-kicker">消费日历</text>
          </view>
          <view class="calendar-card card fade-up">
            <view class="calendar-weekdays">
              <text>日</text>
              <text>一</text>
              <text>二</text>
              <text>三</text>
              <text>四</text>
              <text>五</text>
              <text>六</text>
            </view>
            <view class="calendar-grid">
              <view wx:for="{{calendarCells}}" wx:key="key" class="calendar-cell {{item.blank ? 'is-blank' : ''}} {{item.isActive ? 'is-active' : ''}} {{item.isToday ? 'is-today' : ''}}" data-date="{{item.date}}" bindtap="selectCalendarDay">
                <text wx:if="{{!item.blank}}" class="calendar-day">{{item.day}}</text>
                <view wx:if="{{!item.blank}}" class="calendar-money">
                  <text class="calendar-expense">-{{item.expenseText}}</text>
                  <text class="calendar-income">+{{item.incomeText}}</text>
                </view>
              </view>
            </view>
          </view>
          <view class="showcase-section fade-up">
            <text class="section-kicker">本月关注</text>
          </view>
          <view class="showcase-insights card fade-up">
            <view wx:for="{{insights}}" wx:key="*this" class="showcase-insight">
              <text class="insight-label neutral">提示</text>
              <text>{{item}}</text>
            </view>
          </view>
          <view class="calendar-list-head fade-up">
            <view>
              <text class="section-kicker">{{selectedCalendarDateLabel}}</text>
              <text class="calendar-list-count">共 {{selectedCalendarSummary.count}} 笔</text>
            </view>
            <view class="calendar-day-total">
              <text class="is-income">+¥{{selectedCalendarSummary.incomeText}}</text>
              <text class="is-expense">-¥{{selectedCalendarSummary.expenseText}}</text>
            </view>
          </view>
          <view wx:if="{{selectedCalendarRecords.length}}" class="calendar-detail-list card fade-up">
            <view wx:for="{{selectedCalendarRecords}}" wx:key="_id" class="record-row calendar-detail-row">
              <view class="category-mark {{item.type}}">
                <tl-icon name="{{item.iconName}}" size="32" colorKey="{{item.type === 'income' ? 'income' : 'primary'}}">
                </tl-icon>
              </view>
              <view class="record-main">
                <view class="record-line">
                  <text class="record-title">{{item.categoryText}}</text>
                  <text class="record-amount {{item.type}}">{{item.type === 'income' ? '+' : '-'}}¥{{item.amountText}}</text>
                </view>
                <view class="record-line record-subline">
                  <text class="record-meta">{{item.metaText}}</text>
                </view>
                <text wx:if="{{item.hasNote}}" class="record-note">{{item.noteText}}</text>
              </view>
            </view>
          </view>
          <view wx:else class="calendar-record-empty card fade-up">当天还没有收支记录</view>
        </block>
        <block wx:elif="{{mode === 'custom'}}">
          <view class="custom-range card">
            <text class="card-title">选择日期范围</text>
            <view class="custom-range__dates">
              <picker mode="date" value="{{customStart}}" end="{{customToday}}" bindchange="changeCustomStart">
                <view>{{customStart}} ▾</view>
              </picker>
              <text>至</text>
              <picker mode="date" value="{{customEnd}}" end="{{customToday}}" bindchange="changeCustomEnd">
                <view>{{customEnd}} ▾</view>
              </picker>
            </view>
            <text class="custom-range__note">最多 366 天，比较前一个等长区间。</text>
          </view>
          <view class="analysis-summary-card card fade-up">
            <text class="section-kicker">区间结余</text>
            <text class="summary-title">¥{{overview.balanceText}}</text>
            <text class="summary-copy">收入 ¥{{overview.incomeText}} · 支出 ¥{{overview.expenseText}} · 共 {{overview.recordCount}} 笔</text>
            <text wx:if="{{comparisonRange}}" class="summary-copy">对比 {{comparisonRange.start}} 起至 {{comparisonRange.end}} 前 · 结余 {{balanceCompareText}}</text>
          </view>
          <view class="showcase-section fade-up">
            <text class="section-kicker">区间收支走势</text>
          </view>
          <view wx:if="{{hasChartData}}" class="chart-card card">
            <view class="analysis-chart-canvas">
              <ec-canvas id="analysis-chart" canvas-id="analysis-chart" ec="{{ec}}" bind:init="onChartInit" bind:initerror="onChartInitError" force-use-old-canvas="true">
              </ec-canvas>
            </view>
          </view>
          <tl-empty-state wx:else title="暂无收支记录" description="选择其他日期范围查看">
          </tl-empty-state>
          <view wx:if="{{categories.length}}" class="showcase-section fade-up">
            <text class="section-kicker">支出分类</text>
          </view>
          <view wx:if="{{categories.length}}" class="category-ranking card fade-up">
            <view wx:for="{{categories}}" wx:key="key" class="category-ranking-row" data-index="{{index}}" data-source="custom" bindtap="openCategoryRecords">
              <view class="category-main">
                <text>{{item.name}}</text>
                <text>¥{{item.amountText}} · 占比 {{item.rate}}%</text>
              </view>
              <tl-icon name="arrow-right-s-line" size="24" colorKey="muted">
              </tl-icon>
            </view>
          </view>
        </block>
        <block wx:elif="{{mode === 'all'}}">
          <view class="analysis-summary-card card fade-up">
            <view class="summary-eyebrow">
              <text class="section-kicker">累计结余</text>
            </view>
            <text class="summary-title">¥{{overview.balanceText}}</text>
            <text class="summary-copy">{{overview.saveRateText}} · 共 {{overview.recordCount}} 笔</text>
            <view class="summary-metrics">
              <view class="summary-metric">
                <text>收入</text>
                <text class="is-income">¥{{overview.incomeText}}</text>
              </view>
              <view class="summary-metric">
                <text>支出</text>
                <text class="is-expense">¥{{overview.expenseText}}</text>
              </view>
            </view>
          </view>
          <view class="showcase-section fade-up">
            <text class="section-kicker">累计收支走势</text>
          </view>
          <view class="chart-card card">
            <view class="chart-heading">
              <text class="card-title">{{chartTitle}}</text>
            </view>
            <view class="analysis-chart-canvas">
              <ec-canvas id="analysis-chart" canvas-id="analysis-chart" ec="{{ec}}" bind:init="onChartInit" bind:initerror="onChartInitError" force-use-old-canvas="true">
              </ec-canvas>
            </view>
          </view>
          <view class="showcase-section fade-up">
            <text class="section-kicker">累计支出构成</text>
          </view>
          <view class="chart-card card">
            <view class="analysis-chart-canvas">
              <ec-canvas id="all-category-chart" canvas-id="all-category-chart" data-chart-key="category" ec="{{ec}}" bind:init="onSecondaryChartInit" force-use-old-canvas="true">
              </ec-canvas>
            </view>
          </view>
          <view class="analysis-ratio-list">
            <view wx:for="{{categories}}" wx:key="name" class="analysis-ratio-row">
              <text>{{item.name}}</text>
              <text>¥{{item.amountText}} · {{item.rate}}%</text>
            </view>
          </view>
        </block>
        <tl-empty-state wx:else title="暂无可展示的分析" description="请选择月度、年度或日历查看账本数据">
        </tl-empty-state>
        <block wx:if="{{family && (mode === 'month' || mode === 'year' || mode === 'custom')}}">
          <view class="showcase-section">
            <text class="section-kicker">家庭支出 · ¥{{family.totalText}}</text>
          </view>
          <view class="showcase-insights card">
            <view class="showcase-insight">付款人和消费归属分别统计；公共及多人消费按记录人展示，未知数据计入其他。</view>
          </view>
          <view class="showcase-section">
            <text class="section-kicker">成员付款</text>
          </view>
          <view class="category-ranking card">
            <view wx:for="{{family.payers}}" wx:for-item="member" wx:for-index="memberIndex" wx:key="openid">
              <view class="category-ranking-row" data-dimension="payer" data-index="{{memberIndex}}" bindtap="openFamilyRecords">
                <view class="category-main">
                  <text>{{member.name}}</text>
                  <text>{{member.recordCount}} 笔</text>
                </view>
                <text>¥{{member.amountText}}</text>
              </view>
              <view wx:for="{{member.categories}}" wx:for-item="category" wx:for-index="categoryIndex" wx:key="key" class="family-category-row" data-dimension="payer" data-index="{{memberIndex}}" data-category-index="{{categoryIndex}}" bindtap="openFamilyRecords">
                <text>{{category.parentCategory}} / {{category.name}}</text>
                <text>¥{{category.amountText}}</text>
              </view>
            </view>
          </view>
          <view class="showcase-section">
            <text class="section-kicker">消费归属</text>
          </view>
          <view class="category-ranking card">
            <view wx:for="{{family.consumers}}" wx:for-item="member" wx:for-index="memberIndex" wx:key="openid">
              <view class="category-ranking-row" data-dimension="consumer" data-index="{{memberIndex}}" bindtap="openFamilyRecords">
                <view class="category-main">
                  <text>{{member.name}}</text>
                  <text>{{member.recordCount}} 笔 · 公共 ¥{{member.publicText}} · 多人 ¥{{member.multipleText}}</text>
                </view>
                <text>¥{{member.amountText}}</text>
              </view>
              <view wx:for="{{member.categories}}" wx:for-item="category" wx:for-index="categoryIndex" wx:key="key" class="family-category-row" data-dimension="consumer" data-index="{{memberIndex}}" data-category-index="{{categoryIndex}}" bindtap="openFamilyRecords">
                <text>{{category.parentCategory}} / {{category.name}}</text>
                <text>¥{{category.amountText}}</text>
              </view>
            </view>
          </view>
          <view class="showcase-section">
            <text class="section-kicker">成员录入支出</text>
          </view>
          <view class="category-ranking card">
            <view wx:for="{{members}}" wx:for-item="member" wx:for-index="memberIndex" wx:key="openid">
              <view class="category-ranking-row" data-dimension="creator" data-index="{{memberIndex}}" bindtap="openFamilyRecords">
                <view class="category-main">
                  <text>{{member.name}}</text>
                  <text>{{member.recordCount}} 笔</text>
                </view>
                <text>¥{{member.amountText}}</text>
              </view>
              <view wx:for="{{member.categories}}" wx:for-item="category" wx:for-index="categoryIndex" wx:key="key" class="family-category-row" data-dimension="creator" data-index="{{memberIndex}}" data-category-index="{{categoryIndex}}" bindtap="openFamilyRecords">
                <text>{{category.parentCategory}} / {{category.name}}</text>
                <text>¥{{category.amountText}}</text>
              </view>
            </view>
          </view>
        </block>
      </block>
    </view>
  </scroll-view>
  <tl-bottom-sheet visible="{{ratioRemainderVisible}}" bind:close="closeRatioRemainder">
    <view class="ratio-remainder-heading">
      <text class="card-title">其余分类</text>
      <tl-button class="ratio-sheet-close" variant="text" size="small" bind:tap="closeRatioRemainder">关闭</tl-button>
    </view>
    <text class="ratio-preview-meta">选择一个分类，查看对应明细</text>
    <scroll-view wx:if="{{ratioRemainderOptions.length}}" class="ratio-remainder-scroll" scroll-y="{{true}}" show-scrollbar="{{false}}">
      <view wx:for="{{ratioRemainderOptions}}" wx:key="key" class="analysis-ratio-row" data-key="{{item.key}}" bindtap="chooseRatioRemainder">
        <view class="ratio-category-main">
          <text>{{item.name}}</text>
          <text wx:if="{{item.parentCategory}}" class="ratio-preview-meta">{{item.parentCategory}}</text>
        </view>
        <view class="ratio-category-amount">
          <text>¥{{item.amountText}}</text>
          <tl-icon name="arrow-right-s-line" size="26" colorKey="muted">
          </tl-icon>
        </view>
      </view>
    </scroll-view>
    <tl-empty-state wx:else title="暂无可选分类" description="请刷新分析后重试">
      <tl-button variant="secondary" size="small" bind:tap="refreshRatioAnalysis">刷新分析</tl-button>
    </tl-empty-state>
  </tl-bottom-sheet>
  <tl-bottom-sheet visible="{{isModeSheetVisible}}" bind:close="closeModeSheet">
    <view class="analysis-mode-sheet">
      <view class="analysis-mode-sheet__title">选择分析类型</view>
      <view class="analysis-mode-list">
        <view wx:for="{{modeOptions}}" wx:key="value" class="analysis-mode-option {{item.value === mode ? 'is-active' : ''}}" data-mode="{{item.value}}" bindtap="chooseMode">
          <text>{{item.label}}</text>
          <tl-icon wx:if="{{item.value === mode}}" name="check-line" size="32" colorKey="primary">
          </tl-icon>
        </view>
      </view>
    </view>
  </tl-bottom-sheet>
  <tl-ledger-switcher id="ledger-switcher" visible="{{isLedgerSwitcherVisible}}" ledgers="{{ledgerOptions}}" selected-id="{{ledgerId}}" title="切换账本分析" loading="{{isLoadingLedgers}}" error="{{ledgerLoadError}}" bind:select="chooseViewLedger" bind:close="closeLedgerSwitcher" bind:retry="switchLedger">
  </tl-ledger-switcher>
  <tl-dialog visible="{{isQuestionDialogVisible}}" bind:close="closeQuestionDialog">
    <view class="analysis-question-dialog">
      <view class="analysis-question-dialog__header">
        <text class="analysis-question-dialog__title">{{questionDialogTitle}}</text>
        <view class="analysis-question-dialog__close" bindtap="closeQuestionDialog">
          <tl-icon name="close-line" size="32" colorKey="mutedText">
          </tl-icon>
        </view>
      </view>
      <text class="analysis-question-dialog__copy">{{questionDialogContent}}</text>
    </view>
  </tl-dialog>
</view>
