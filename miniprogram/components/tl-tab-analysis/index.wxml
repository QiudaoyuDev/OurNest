<view class="tab-panel analysis-page">
  <view class="analysis-header fade-up">
    <view class="analysis-primary-tabs mode-segmented-control">
      <view class="analysis-primary-tab {{mode === 'week' ? 'is-active' : ''}}" data-mode="week" bindtap="switchMode">周度</view>
      <view class="analysis-primary-tab {{mode === 'month' ? 'is-active' : ''}}" data-mode="month" bindtap="switchMode">月度</view>
      <view class="analysis-primary-tab {{mode === 'year' ? 'is-active' : ''}}" data-mode="year" bindtap="switchMode">年度</view>
      <view class="analysis-primary-tab {{mode === 'custom' ? 'is-active' : ''}}" data-mode="custom" bindtap="switchMode">自定义</view>
      <view class="analysis-primary-tab {{mode === 'all' ? 'is-active' : ''}}" data-mode="all" bindtap="switchMode">累计</view>
    </view>
    <view class="analysis-action-bar" wx:if="{{mode !== 'custom'}}">
      <view class="analysis-context-bar">
        <view wx:if="{{mode === 'week' || mode === 'month' || mode === 'year'}}" class="context-period">
          <view class="context-nav" data-delta="-1" bindtap="shift">
            <tl-icon name="arrow-left-s-line" size="36" colorKey="primary">
            </tl-icon>
          </view>
          <picker mode="date" fields="{{mode === 'year' ? 'year' : mode === 'month' ? 'month' : 'day'}}" value="{{anchor}}" end="{{customToday}}" bindchange="chooseAnalysisDate" class="context-picker">
            <view class="context-picker-btn">
              <text class="context-period-text">{{rangeLabel}}</text>
              <tl-icon name="arrow-down-s-fill" size="20" colorKey="primary">
              </tl-icon>
            </view>
          </picker>
          <view class="context-nav {{canShiftNext ? '' : 'is-disabled'}}" data-delta="1" bindtap="shift">
            <tl-icon name="arrow-right-s-line" size="36" colorKey="primary">
            </tl-icon>
          </view>
        </view>
        <view wx:elif="{{mode === 'all'}}" class="context-period is-static">
          <tl-icon name="calendar-todo-line" size="26" colorKey="primary">
          </tl-icon>
          <text class="context-period-text">全部历史汇总</text>
        </view>
      </view>
      <view class="dashboard-controls">
        <view class="dashboard-toggle">
          <view class="dashboard-toggle-item {{analysisType === 'expense' ? 'is-active' : ''}}" data-type="expense" bindtap="changeAnalysisType">支出</view>
          <view class="dashboard-toggle-item {{analysisType === 'income' ? 'is-active' : ''}}" data-type="income" bindtap="changeAnalysisType">收入</view>
        </view>
      </view>
    </view>
    <view class="analysis-action-bar is-custom" wx:else>
      <view class="analysis-custom-kicker">
        <tl-icon name="calendar-check-line" size="28" colorKey="primary">
        </tl-icon>
        <text>按日期区间统计</text>
      </view>
      <view class="dashboard-controls">
        <view class="dashboard-toggle">
          <view class="dashboard-toggle-item {{analysisType === 'expense' ? 'is-active' : ''}}" data-type="expense" bindtap="changeAnalysisType">支出</view>
          <view class="dashboard-toggle-item {{analysisType === 'income' ? 'is-active' : ''}}" data-type="income" bindtap="changeAnalysisType">收入</view>
        </view>
      </view>
    </view>
  </view>
  <scroll-view class="analysis-scroll" bindscroll="onAnalysisScroll" scroll-top="{{scrollTop}}" scroll-y="{{true}}" enhanced="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
    <view class="page-content">
      <tl-skeleton wx:if="{{loading}}" variant="analysis">
      </tl-skeleton>
      <tl-empty-state wx:elif="{{error}}" variant="error" title="分析数据加载失败" description="请检查网络后重新加载">
        <tl-button variant="secondary" size="small" bind:tap="reload">重新加载</tl-button>
      </tl-empty-state>
      <tl-empty-state wx:elif="{{noLedger}}" title="还没有可分析的账本" description="创建账本并记下第一笔收支后，这里会生成分析">
        <tl-button variant="secondary" size="small" bind:tap="createLedger">创建账本</tl-button>
      </tl-empty-state>
      <block>
        <view class="analysis-content {{loading || error || noLedger ? 'is-analysis-hidden' : ''}}">
          <tl-empty-state wx:if="{{!hasRecords}}" title="暂无收支记录" description="选择其他日期范围查看">
          </tl-empty-state>
          <block wx:if="{{hasRecords && (mode === 'week' || mode === 'month' || mode === 'year')}}">
            <view class="analysis-summary-card analysis-overview-card card dashboard-hero">
              <view class="overview-top-row">
                <view class="overview-main-info">
                  <text class="section-kicker">{{rangeLabel}} · {{dashboardView.typeLabel}}</text>
                  <text class="summary-title t-num">¥{{dashboardView.totalText}}</text>
                  <text class="summary-copy">共 {{dashboardView.recordCount}} 笔 · 日均 ¥{{dashboardView.dailyAverageText}}</text>
                </view>
                <view class="overview-badges">
                  <view class="overview-report-btn" bindtap="openMonthlyReportSheet">
                    <tl-icon name="file-text-line" size="24" colorKey="primary">
                    </tl-icon>
                    <text>生活月报</text>
                  </view>
                  <view class="overview-balance-badge {{dashboardView.isBalancePositive ? 'is-positive' : 'is-negative'}}">
                    <text class="badge-label">结余</text>
                    <text class="badge-amount t-num">¥{{dashboardView.balanceText}}</text>
                  </view>
                  <text class="overview-compare-tag">{{dashboardView.comparisonTag || dashboardView.comparisonText}}</text>
                </view>
              </view>
              <view class="editorial-narrative-box">
                <view class="narrative-icon-wrap">
                  <tl-icon name="chat-smile-2-line" size="28" colorKey="primary">
                  </tl-icon>
                </view>
                <text class="narrative-text">{{dashboardView.editorialSummary}}</text>
              </view>
              <view wx:if="{{family && analysisType === 'expense' && family.payers.length}}" class="family-contribution-strip" data-section="family" bindtap="goSection">
                <view class="strip-header">
                  <view class="strip-title-group">
                    <tl-icon name="team-line" size="26" colorKey="primary">
                    </tl-icon>
                    <text class="strip-title">全家付款贡献</text>
                  </view>
                  <text class="strip-action">明细 ›</text>
                </view>
                <view class="family-members-row">
                  <view wx:for="{{family.payers}}" wx:key="openid" class="family-member-pill">
                    <view class="member-avatar-chip">{{item.name[0]}}</view>
                    <text class="member-name">{{item.name}}</text>
                    <text class="member-amount t-num">¥{{item.amountText}}</text>
                    <text class="member-rate">({{item.rate}}%)</text>
                  </view>
                </view>
              </view>
              <view class="summary-metrics">
                <view class="summary-metric">
                  <text>本期收入</text>
                  <text class="is-income t-num">¥{{dashboardView.incomeText}}</text>
                </view>
                <view class="summary-metric">
                  <text>本期支出</text>
                  <text class="is-expense t-num">¥{{dashboardView.expenseText}}</text>
                </view>
                <view class="summary-metric">
                  <text>本期结余</text>
                  <text class="t-num">¥{{dashboardView.balanceText}}</text>
                </view>
              </view>
            </view>
            <view class="dashboard-sections">
              <view class="{{activeSection === 'summary' ? 'is-active' : ''}}" data-section="summary" bindtap="goSection">小结</view>
              <view class="{{activeSection === 'category' ? 'is-active' : ''}}" data-section="category" bindtap="goSection">分类</view>
              <view class="{{activeSection === 'account' ? 'is-active' : ''}}" data-section="account" bindtap="goSection">账户</view>
              <view wx:if="{{family && analysisType === 'expense'}}" class="{{activeSection === 'family' ? 'is-active' : ''}}" data-section="family" bindtap="goSection">共享支出</view>
            </view>
            <view id="analysis-summary" class="dashboard-card card">
              <view class="dashboard-heading">
                <text class="card-title">{{mode === 'week' ? '本周走势' : mode === 'month' ? '月度走势' : '年度走势'}}</text>
                <text class="dashboard-meta">最高 ¥{{dashboardView.maxText}}</text>
              </view>
              <view class="chart-tooltip-bar {{selectedBar ? 'is-active' : ''}}" bindtap="openSelectedMonth">
                <block wx:if="{{selectedBar}}">
                  <view class="tooltip-data-group">
                    <text class="tooltip-label">{{selectedBar.key}}</text>
                    <text class="tooltip-amount t-num">¥{{selectedBar.amountText}}</text>
                  </view>
                  <view class="tooltip-action-group">
                    <text class="tooltip-action">看流水 ›</text>
                  </view>
                </block>
                <view wx:else class="tooltip-hint-group">
                  <tl-icon name="cursor-line" size="24" colorKey="tertiary">
                  </tl-icon>
                  <text class="tooltip-hint">点击柱体查看当期收支详情</text>
                </view>
              </view>
              <view class="dashboard-chart">
                <view class="dashboard-grid">
                  <view>
                  </view>
                  <view>
                  </view>
                  <view>
                  </view>
                </view>
                <view wx:for="{{dashboardView.bars}}" wx:key="key" class="dashboard-bar-column" data-index="{{index}}" bindtap="selectDashboardBar">
                  <view class="dashboard-bars">
                    <view wx:if="{{mode === 'week'}}" class="dashboard-bar is-previous" style="height: {{item.previousHeight}}%;">
                    </view>
                    <view class="dashboard-bar {{item.future ? 'is-future' : ''}} {{item.partial ? 'is-partial' : ''}} {{selectedBar && selectedBar.key === item.key ? 'is-selected' : ''}}" style="height: {{item.height}}%;">
                    </view>
                  </view>
                  <text class="dashboard-bar-label">{{item.label}}</text>
                </view>
              </view>
              <view class="dashboard-insight">{{mode === 'week' ? '浅色为上周，深色为本周 · 日均' : mode === 'month' ? '近6个月月均' : '已到月份月均'}} ¥{{dashboardView.averageText}} {{trendCaption}} {{trendCaption ? '（含未结束周期）' : ''}}</view>
              <tl-button variant="text" size="small" bind:tap="toggleTrendDetails">{{showTrendDetails ? '收起趋势明细' : '查看趋势明细'}}</tl-button>
              <view wx:if="{{showTrendDetails}}">
                <view wx:for="{{dashboardView.bars}}" wx:key="key" class="dashboard-row" data-index="{{index}}" bindtap="selectDashboardBar">
                  <text>{{item.label}}</text>
                  <text>{{item.future ? '未到日期' : '¥' + item.amountText}}</text>
                </view>
              </view>
              <view wx:if="{{selectedBar}}" class="dashboard-row" bindtap="openSelectedMonth">
                <text>{{selectedBar.key}}：¥{{selectedBar.amountText}}</text>
                <text>查看明细 ›</text>
              </view>
              <block wx:if="{{mode === 'month'}}">
                <view class="dashboard-subheading">{{analysisType === 'income' ? '收入日历足迹' : '支出日历足迹'}}</view>
                <view class="calendar-weekdays">
                  <text>日</text>
                  <text>一</text>
                  <text>二</text>
                  <text>三</text>
                  <text>四</text>
                  <text>五</text>
                  <text>六</text>
                </view>
                <view class="dashboard-calendar">
                  <view wx:for="{{dashboardView.cells}}" wx:key="key" wx:if="{{calendarExpanded || (index >= calendarStart && index < calendarStart + 14)}}" class="dashboard-day {{item.blank ? 'is-blank' : ''}} {{item.isToday ? 'is-today' : ''}} {{item.future ? 'is-future' : ''}} {{item.hasAmount ? 'has-amount' : ''}} {{selectedDay === item.key ? 'is-selected' : ''}}" data-date="{{item.blank ? '' : item.key}}" bindtap="selectDashboardDay">
                    <text wx:if="{{!item.blank}}" class="dashboard-day-number">{{item.isToday ? '今天' : item.day}}</text>
                    <text wx:if="{{!item.blank}}" class="dashboard-day-amount">{{item.amountText}}</text>
                  </view>
                </view>
                <tl-button variant="text" size="small" bind:tap="toggleCalendar">{{calendarExpanded ? '收起日历' : '展开全部'}}</tl-button>
                <view wx:if="{{selectedDay}}" class="dashboard-day-detail">
                  <view class="dashboard-day-detail__header">
                    <text class="dashboard-subheading">{{selectedDay}} 明细</text>
                    <view class="day-detail-close" bindtap="closeDashboardDay">
                      <tl-icon name="close-line" size="28" colorKey="muted">
                      </tl-icon>
                    </view>
                  </view>
                  <text wx:if="{{dayStatus === 'ready' || dayStatus === 'loadingMore'}}" class="dashboard-meta">{{dashboardView.typeLabel}}合计 ¥{{dayAmountText}}</text>
                  <tl-skeleton wx:if="{{dayStatus === 'loading'}}" variant="list">
                  </tl-skeleton>
                  <tl-empty-state wx:elif="{{dayStatus === 'error'}}" variant="error" title="明细加载失败">
                    <tl-button variant="secondary" size="small" bind:tap="retryDashboardDay">重试</tl-button>
                  </tl-empty-state>
                  <block wx:else>
                    <tl-analysis-record wx:for="{{dayRecords}}" wx:key="_id" record="{{item}}" type="{{analysisType}}" bind:open="openDashboardRecord">
                    </tl-analysis-record>
                    <tl-empty-state wx:if="{{!dayRecords.length}}" title="当天暂无记录">
                    </tl-empty-state>
                    <tl-button wx:if="{{dayHasMore}}" variant="text" size="small" loading="{{dayStatus === 'loadingMore'}}" bind:tap="loadMoreDashboardDay">加载更多</tl-button>
                  </block>
                </view>
              </block>
            </view>
            <view class="dashboard-card card">
              <view class="dashboard-heading">
                <text class="card-title">{{dashboardView.typeLabel}}排行</text>
                <text bindtap="openDashboardRecords">查看全部 ›</text>
              </view>
              <tl-analysis-record wx:for="{{dashboardView.topRecords}}" wx:key="_id" record="{{item}}" type="{{analysisType}}" rank="{{index + 1}}" bind:open="openDashboardRecord">
              </tl-analysis-record>
              <tl-empty-state wx:if="{{!dashboardView.topRecords.length}}" title="本期暂无记录">
              </tl-empty-state>
            </view>
            <view id="analysis-category" class="dashboard-card card">
              <view class="dashboard-heading">
                <text class="card-title">{{dashboardView.typeLabel}}分类</text>
                <view bindtap="toggleCategoryComparison">对比上期 {{compareCategories ? '●' : '○'}}</view>
              </view>
              <view wx:if="{{chartHostMounted && chartFirstReadyEver && dashboardView.recordCount}}" id="dashboard-category-chart-wrap" class="analysis-chart-canvas {{categoryChartHidden ? 'is-chart-hidden' : ''}}">
                <ec-canvas wx:if="{{categoryChartActivated}}" id="dashboard-category-chart" canvas-id="dashboard-category-chart" data-chart-host="secondary" data-chart-key="dashboardCategory" data-chart-generation="{{chartHostGeneration}}" ec="{{ec}}" bind:init="onSecondaryChartInit" bind:initerror="onSecondaryChartInitError">
                </ec-canvas>
              </view>
              <text wx:if="{{dashboardChartError}}" class="dashboard-meta">图表加载失败，可查看下方分类列表。</text>
              <tl-button wx:if="{{dashboardChartError}}" variant="text" size="small" bind:tap="retryCategoryChart">重试图表</tl-button>
              <view wx:for="{{dashboardView.categories}}" wx:key="key">
                <view wx:if="{{showAllCategories || index < 5}}" class="dashboard-row dashboard-category-row {{selectedCategory && selectedCategory.key === item.key ? 'is-expanded' : ''}}" data-index="{{index}}" bindtap="selectDashboardCategory">
                  <text class="dashboard-rank {{index === 0 ? 'top-1' : index === 1 ? 'top-2' : index === 2 ? 'top-3' : ''}}">{{index + 1}}</text>
                  <view class="category-chart-dot" style="background: {{item.chartColor}};">
                  </view>
                  <view class="dashboard-category-icon {{item.chipClass || analysisType}}">
                    <tl-icon name="{{item.displayIcon}}" size="32" color="{{item.iconColor || (analysisType === 'income' ? '#25a66a' : '#f0442f')}}">
                    </tl-icon>
                  </view>
                  <view class="dashboard-row-content">
                    <text class="dashboard-row-title">{{item.name}}</text>
                    <view class="category-progress-wrap">
                      <view class="category-progress-track">
                        <view class="category-progress-fill" style="width: {{item.rate}}%; background: {{item.chartColor}};">
                        </view>
                      </view>
                      <text class="dashboard-meta">{{item.parentCategory ? item.parentCategory + ' · ' : ''}}占比 {{item.rate}}%</text>
                    </view>
                    <text wx:if="{{compareCategories}}" class="dashboard-meta">上期 ¥{{item.previousText}} · {{item.deltaDirection}} ¥{{item.deltaText}}</text>
                  </view>
                  <view class="dashboard-row-value">
                    <text class="dashboard-amount {{analysisType}}">¥{{item.amountText}}</text>
                    <text class="dashboard-meta">{{item.recordCount}} 笔</text>
                  </view>
                  <tl-icon wx:if="{{item.recordCount}}" name="{{selectedCategory && selectedCategory.key === item.key ? 'arrow-up-s-line' : 'arrow-down-s-line'}}" size="28" colorKey="muted">
                  </tl-icon>
                </view>
                <view wx:if="{{(showAllCategories || index < 5) && selectedCategory && selectedCategory.key === item.key}}" class="dashboard-preview">
                  <tl-skeleton wx:if="{{categoryPreviewStatus === 'loading'}}" variant="list">
                  </tl-skeleton>
                  <tl-empty-state wx:elif="{{categoryPreviewStatus === 'error' || categoryPreviewStatus === 'stale'}}" variant="error" title="{{categoryPreviewStatus === 'stale' ? '分析数据需要刷新' : '明细加载失败'}}">
                    <tl-button variant="secondary" size="small" bind:tap="reload">刷新分析</tl-button>
                  </tl-empty-state>
                  <block wx:elif="{{categoryPreviewStatus === 'ready'}}">
                    <text class="dashboard-preview-heading">最近 {{categoryPreview.length}} 笔</text>
                    <tl-analysis-record wx:for="{{categoryPreview}}" wx:for-item="record" wx:key="_id" record="{{record}}" type="{{analysisType}}" prefer-note="{{true}}" bind:open="openDashboardRecord">
                    </tl-analysis-record>
                    <tl-button variant="text" size="small" bind:tap="openDashboardCategoryRecords">查看全部 {{item.recordCount}} 笔</tl-button>
                  </block>
                </view>
              </view>
              <tl-button wx:if="{{dashboardView.categories.length > 5}}" variant="text" size="small" bind:tap="toggleCategories">{{showAllCategories ? '收起' : '展开全部'}}</tl-button>
              <tl-empty-state wx:if="{{!dashboardView.categories.length}}" title="本期暂无分类数据">
              </tl-empty-state>
            </view>
            <view id="analysis-account" class="dashboard-card card">
              <text class="card-title">{{analysisType === 'expense' ? '支付账户' : '收款账户'}}</text>
              <view wx:for="{{dashboardView.accounts}}" wx:key="index" class="dashboard-row" data-index="{{index}}" bindtap="openDashboardAccount">
                <view class="dashboard-category-icon {{analysisType}}">
                  <tl-icon name="wallet-3-line" size="32" colorKey="{{analysisType === 'income' ? 'income' : 'primary'}}">
                  </tl-icon>
                </view>
                <view class="dashboard-row-content">
                  <text class="dashboard-row-title">{{item.name}}</text>
                  <text class="dashboard-meta">占比 {{item.rate}}%</text>
                </view>
                <view class="dashboard-row-value">
                  <text class="dashboard-amount {{analysisType}}">¥{{item.amountText}}</text>
                  <text class="dashboard-meta">{{item.recordCount}} 笔 ›</text>
                </view>
              </view>
              <tl-empty-state wx:if="{{!dashboardView.accounts.length}}" title="本期暂无账户数据">
              </tl-empty-state>
            </view>
          </block>
          <block wx:elif="{{mode === 'custom' || mode === 'all'}}">
            <view wx:if="{{mode === 'custom'}}" class="custom-range card">
              <view class="date-preset-bar">
                <view class="preset-pill {{customPreset === '7d' ? 'is-active' : ''}}" data-preset="7d" bindtap="applyDatePreset">近7天</view>
                <view class="preset-pill {{customPreset === '30d' ? 'is-active' : ''}}" data-preset="30d" bindtap="applyDatePreset">近30天</view>
                <view class="preset-pill {{customPreset === 'month' ? 'is-active' : ''}}" data-preset="month" bindtap="applyDatePreset">本月</view>
                <view class="preset-pill {{customPreset === 'year' ? 'is-active' : ''}}" data-preset="year" bindtap="applyDatePreset">今年</view>
              </view>
              <view class="custom-range__dates">
                <picker mode="date" value="{{customStart}}" end="{{customToday}}" bindchange="changeCustomStart" class="custom-date-picker">
                  <view class="custom-date-box">
                    <tl-icon name="calendar-line" size="26" colorKey="primary">
                    </tl-icon>
                    <text class="custom-date-text">{{customStart}}</text>
                    <tl-icon name="arrow-down-s-fill" size="20" colorKey="tertiary">
                    </tl-icon>
                  </view>
                </picker>
                <view class="custom-range__separator">至</view>
                <picker mode="date" value="{{customEnd}}" end="{{customToday}}" bindchange="changeCustomEnd" class="custom-date-picker">
                  <view class="custom-date-box">
                    <tl-icon name="calendar-line" size="26" colorKey="primary">
                    </tl-icon>
                    <text class="custom-date-text">{{customEnd}}</text>
                    <tl-icon name="arrow-down-s-fill" size="20" colorKey="tertiary">
                    </tl-icon>
                  </view>
                </picker>
              </view>
              <view class="custom-range__footer">
                <view class="custom-range__days-badge" wx:if="{{customDays > 0}}">
                  <tl-icon name="time-line" size="22" colorKey="primary">
                  </tl-icon>
                  <text>共 {{customDays}} 天</text>
                </view>
                <text class="custom-range__note">对比前一个等长区间 · 最多 366 天</text>
              </view>
            </view>
            <block wx:if="{{hasRecords}}">
              <view class="analysis-summary-card card dashboard-hero">
                <text class="section-kicker">{{mode === 'custom' ? '区间' : '累计'}}{{analysisType === 'income' ? '收入' : '支出'}}</text>
                <text class="summary-title">¥{{analysisType === 'income' ? overview.incomeText : overview.expenseText}}</text>
                <text class="summary-copy">{{directionRecordCount === null ? '收支共 ' + overview.recordCount : '共 ' + directionRecordCount}} 笔 · 结余 ¥{{overview.balanceText}}（收入减支出）</text>
                <text wx:if="{{comparisonRange}}" class="summary-copy">对比 {{comparisonRange.start}} 起至 {{comparisonRange.end}} 前 · 结余 {{balanceCompareText}}</text>
                <view class="summary-metrics">
                  <view class="summary-metric">
                    <text>收入</text>
                    <text class="is-income">¥{{overview.incomeText}}</text>
                  </view>
                  <view class="summary-metric">
                    <text>支出</text>
                    <text class="is-expense">¥{{overview.expenseText}}</text>
                  </view>
                  <view class="summary-metric">
                    <text>结余</text>
                    <text>¥{{overview.balanceText}}</text>
                  </view>
                </view>
              </view>
              <view class="showcase-section fade-up">
                <text class="section-kicker">{{mode === 'custom' ? '区间' : '累计'}}综合收支走势（不受收支切换影响）</text>
              </view>
              <view wx:if="{{chartHostMounted && chartFirstReadyEver && hasChartData}}" class="chart-card card">
                <view class="analysis-chart-canvas">
                  <ec-canvas wx:if="{{mode === 'custom'}}" id="analysis-chart" canvas-id="analysis-chart" data-chart-host="main" data-chart-generation="{{chartHostGeneration}}" ec="{{ec}}" bind:init="onChartInit" bind:initerror="onChartInitError">
                  </ec-canvas>
                  <ec-canvas wx:elif="{{mode === 'all'}}" id="analysis-chart" canvas-id="analysis-chart" data-chart-host="main" data-chart-generation="{{chartHostGeneration}}" ec="{{ec}}" bind:init="onChartInit" bind:initerror="onChartInitError">
                  </ec-canvas>
                </view>
                <tl-button wx:if="{{trendChartError}}" variant="text" size="small" bind:tap="retryTrendChart">图表加载失败，重试</tl-button>
                <view wx:if="{{selectedTrend}}" class="dashboard-row" bindtap="openSelectedTrend">
                  <text>{{selectedTrend.label}} · 收入 ¥{{selectedTrend.incomeText}} · 支出 ¥{{selectedTrend.expenseText}} · 结余 ¥{{selectedTrend.balanceText}}</text>
                  <text>查看明细 ›</text>
                </view>
                <view class="timeline-detail-box">
                  <view class="timeline-header">
                    <text class="timeline-title">趋势明细</text>
                    <view class="timeline-cols-head">
                      <text class="th-cell th-inc">收入</text>
                      <text class="th-cell th-exp">支出</text>
                      <text class="th-cell th-bal">结余</text>
                    </view>
                  </view>
                  <view class="timeline-table">
                    <view wx:for="{{trendRows}}" wx:key="key" wx:if="{{showTrendDetails || index < 6}}" class="timeline-row {{selectedTrendKey === item.key ? 'is-active-row' : ''}}" data-index="{{index}}" data-key="{{item.key}}" bindtap="openTrendRow">
                      <view class="date-badge-box">
                        <text class="date-badge">{{item.label}}</text>
                      </view>
                      <view class="timeline-data-grid">
                        <text class="val-cell val-inc {{item.income > 0 ? 'has-val' : 'is-zero'}}">{{item.income > 0 ? '¥' + item.incomeText : '0.00'}}</text>
                        <text class="val-cell val-exp {{item.expense > 0 ? 'has-val' : 'is-zero'}}">{{item.expense > 0 ? '¥' + item.expenseText : '0.00'}}</text>
                        <text class="val-cell val-bal {{item.balance >= 0 ? 'is-surplus' : 'is-deficit'}}">{{item.balance >= 0 ? '+' : ''}}¥{{item.balanceText}}</text>
                      </view>
                    </view>
                  </view>
                  <tl-button wx:if="{{trendRows.length > 6}}" variant="text" size="small" bind:tap="toggleTrendDetails">{{showTrendDetails ? '收起趋势明细' : '展开全部趋势明细 (' + trendRows.length + ' 期)'}}</tl-button>
                </view>
              </view>
              <view wx:if="{{mode === 'all' && chartHostMounted && chartFirstReadyEver && rangeCategories.length}}" class="chart-card card">
                <view wx:if="{{chartHostMounted && chartFirstReadyEver && rangeCategories.length}}" class="analysis-chart-canvas">
                  <ec-canvas id="all-category-chart" canvas-id="all-category-chart" data-chart-host="secondary" data-chart-key="category" data-chart-generation="{{chartHostGeneration}}" ec="{{ec}}" bind:init="onSecondaryChartInit" bind:initerror="onSecondaryChartInitError">
                  </ec-canvas>
                </view>
                <tl-button wx:if="{{dashboardChartError}}" variant="text" size="small" bind:tap="retryCategoryChart">图表加载失败，重试</tl-button>
              </view>
              <view wx:if="{{rangeCategories.length}}" class="category-ranking card fade-up">
                <view class="dashboard-heading">
                  <text class="card-title">{{analysisType === 'expense' ? '支出分类排行' : '收入分类排行'}}</text>
                </view>
                <view wx:for="{{rangeCategories}}" wx:key="key">
                  <view class="dashboard-row dashboard-category-row" data-index="{{index}}" bindtap="selectDashboardCategory">
                    <text class="dashboard-rank {{index === 0 ? 'top-1' : index === 1 ? 'top-2' : index === 2 ? 'top-3' : ''}}">{{index + 1}}</text>
                    <view class="category-chart-dot" style="background: {{item.chartColor}};">
                    </view>
                    <view class="dashboard-category-icon {{item.chipClass || analysisType}}">
                      <tl-icon name="{{item.displayIcon}}" size="32" color="{{item.iconColor || (analysisType === 'income' ? '#25a66a' : '#f0442f')}}">
                      </tl-icon>
                    </view>
                    <view class="dashboard-row-content">
                      <text class="dashboard-row-title">{{item.name}}</text>
                      <text class="dashboard-meta">占比 {{item.rate}}%</text>
                    </view>
                    <view class="dashboard-row-value">
                      <text class="dashboard-amount {{analysisType}}">¥{{item.amountText}}</text>
                    </view>
                    <tl-icon name="arrow-right-s-line" size="28" colorKey="muted">
                    </tl-icon>
                  </view>
                  <view wx:if="{{selectedCategory && selectedCategory.key === item.key}}" class="dashboard-preview">
                    <tl-skeleton wx:if="{{categoryPreviewStatus === 'loading'}}" variant="list">
                    </tl-skeleton>
                    <tl-empty-state wx:elif="{{categoryPreviewStatus === 'error' || categoryPreviewStatus === 'stale'}}" variant="error" title="明细加载失败">
                      <tl-button variant="secondary" size="small" bind:tap="reload">刷新分析</tl-button>
                    </tl-empty-state>
                    <block wx:elif="{{categoryPreviewStatus === 'ready'}}">
                      <tl-analysis-record wx:for="{{categoryPreview}}" wx:for-item="record" wx:key="_id" record="{{record}}" type="{{analysisType}}" bind:open="openDashboardRecord">
                      </tl-analysis-record>
                      <tl-button variant="text" size="small" bind:tap="openDashboardCategoryRecords">查看全部 {{categoryPreviewCount}} 笔</tl-button>
                    </block>
                  </view>
                </view>
              </view>
            </block>
          </block>
          <block wx:if="{{hasRecords && family && analysisType === 'expense' && (mode === 'week' || mode === 'month' || mode === 'year' || mode === 'custom')}}">
            <view id="analysis-family">
            </view>
            <view class="showcase-section">
              <text class="section-kicker">家庭支出 · ¥{{family.totalText}}</text>
            </view>
            <view class="showcase-insights card">
              <view class="showcase-insight">记录全家共同开支，透明分摊更安心；支持按付款人与消费归属分别查看。</view>
            </view>
            <view wx:if="{{dashboardView.settlement && dashboardView.settlement.enabled}}" class="family-settlement-card card">
              <view class="settlement-header">
                <view class="settlement-title-group">
                  <tl-icon name="hand-coin-line" size="28" colorKey="primary">
                  </tl-icon>
                  <text class="settlement-title">伴侣 AA 垫付对账建议</text>
                </view>
                <view class="settlement-copy-btn" bindtap="copySettlementBill">
                  <tl-icon name="file-copy-line" size="24" colorKey="primary">
                  </tl-icon>
                  <text>复制对账单</text>
                </view>
              </view>
              <view class="settlement-advice-box">
                <text class="settlement-advice">{{dashboardView.settlement.advice}}</text>
              </view>
            </view>
            <view class="showcase-section">
              <text class="section-kicker">成员付款</text>
            </view>
            <view class="category-ranking card">
              <view wx:for="{{family.payers}}" wx:for-item="member" wx:for-index="memberIndex" wx:key="openid">
                <view class="category-ranking-row" data-dimension="payer" data-index="{{memberIndex}}" bindtap="openFamilyRecords">
                  <view class="dashboard-category-icon expense">
                    <tl-icon name="user-3-line" size="32" colorKey="primary">
                    </tl-icon>
                  </view>
                  <view class="category-main">
                    <text>{{member.name}}</text>
                    <text>{{member.recordCount}} 笔</text>
                  </view>
                  <text>¥{{member.amountText}}</text>
                </view>
                <view wx:for="{{member.categories}}" wx:for-item="category" wx:for-index="categoryIndex" wx:key="key" class="family-category-row" data-dimension="payer" data-index="{{memberIndex}}" data-category-index="{{categoryIndex}}" bindtap="openFamilyRecords">
                  <tl-icon name="{{category.categoryIcon || 'price-tag-3-line'}}" size="28" colorKey="primary">
                  </tl-icon>
                  <text class="dashboard-row-content">{{category.name}}</text>
                  <text class="dashboard-amount">¥{{category.amountText}}</text>
                </view>
              </view>
            </view>
            <view class="showcase-section">
              <text class="section-kicker">消费归属</text>
            </view>
            <view class="category-ranking card">
              <view wx:for="{{family.consumers}}" wx:for-item="member" wx:for-index="memberIndex" wx:key="openid">
                <view class="category-ranking-row" data-dimension="consumer" data-index="{{memberIndex}}" bindtap="openFamilyRecords">
                  <view class="dashboard-category-icon expense">
                    <tl-icon name="user-3-line" size="32" colorKey="primary">
                    </tl-icon>
                  </view>
                  <view class="category-main">
                    <text>{{member.name}}</text>
                    <text>{{member.recordCount}} 笔 · 公共 ¥{{member.publicText}} · 多人 ¥{{member.multipleText}}</text>
                  </view>
                  <text>¥{{member.amountText}}</text>
                </view>
                <view wx:for="{{member.categories}}" wx:for-item="category" wx:for-index="categoryIndex" wx:key="key" class="family-category-row" data-dimension="consumer" data-index="{{memberIndex}}" data-category-index="{{categoryIndex}}" bindtap="openFamilyRecords">
                  <tl-icon name="{{category.categoryIcon || 'price-tag-3-line'}}" size="28" colorKey="primary">
                  </tl-icon>
                  <text class="dashboard-row-content">{{category.name}}</text>
                  <text class="dashboard-amount">¥{{category.amountText}}</text>
                </view>
              </view>
            </view>
            <view class="showcase-section">
              <text class="section-kicker">成员录入支出</text>
            </view>
            <view class="category-ranking card">
              <view wx:for="{{members}}" wx:for-item="member" wx:for-index="memberIndex" wx:key="openid">
                <view class="category-ranking-row" data-dimension="creator" data-index="{{memberIndex}}" bindtap="openFamilyRecords">
                  <view class="dashboard-category-icon expense">
                    <tl-icon name="user-3-line" size="32" colorKey="primary">
                    </tl-icon>
                  </view>
                  <view class="category-main">
                    <text>{{member.name}}</text>
                    <text>{{member.recordCount}} 笔</text>
                  </view>
                  <text>¥{{member.amountText}}</text>
                </view>
                <view wx:for="{{member.categories}}" wx:for-item="category" wx:for-index="categoryIndex" wx:key="key" class="family-category-row" data-dimension="creator" data-index="{{memberIndex}}" data-category-index="{{categoryIndex}}" bindtap="openFamilyRecords">
                  <tl-icon name="{{category.categoryIcon || 'price-tag-3-line'}}" size="28" colorKey="primary">
                  </tl-icon>
                  <text class="dashboard-row-content">{{category.name}}</text>
                  <text class="dashboard-amount">¥{{category.amountText}}</text>
                </view>
              </view>
            </view>
          </block>
        </view>
      </block>
      <view wx:if="{{sectionEndSpace}}" style="height: {{sectionEndSpace}}px;">
      </view>
    </view>
  </scroll-view>
  <tl-bottom-sheet visible="{{ratioRemainderVisible}}" bind:close="closeRatioRemainder">
    <view class="ratio-remainder-heading">
      <text class="card-title">其余分类</text>
      <tl-button class="ratio-sheet-close" variant="text" size="small" bind:tap="closeRatioRemainder">关闭</tl-button>
    </view>
    <text class="ratio-preview-meta">选择一个分类，查看对应明细</text>
    <scroll-view wx:if="{{ratioRemainderOptions.length}}" class="ratio-remainder-scroll" scroll-y="{{true}}" show-scrollbar="{{false}}">
      <view wx:for="{{ratioRemainderOptions}}" wx:key="key" class="analysis-ratio-row" data-key="{{item.key}}" bindtap="chooseRatioRemainder">
        <view class="ratio-category-main">
          <text>{{item.name}}</text>
          <text wx:if="{{item.parentCategory}}" class="ratio-preview-meta">{{item.parentCategory}}</text>
        </view>
        <view class="ratio-category-amount">
          <text>¥{{item.amountText}}</text>
          <tl-icon name="arrow-right-s-line" size="26" colorKey="muted">
          </tl-icon>
        </view>
      </view>
    </scroll-view>
    <tl-empty-state wx:else title="暂无可选分类" description="请刷新分析后重试">
      <tl-button variant="secondary" size="small" bind:tap="refreshRatioAnalysis">刷新分析</tl-button>
    </tl-empty-state>
  </tl-bottom-sheet>
  <tl-bottom-sheet visible="{{isMonthlyReportVisible}}" bind:close="closeMonthlyReportSheet">
    <view class="monthly-report-sheet">
      <view class="monthly-report-sheet__header">
        <text class="card-title">咱家生活月报</text>
        <tl-button variant="text" size="small" bind:tap="closeMonthlyReportSheet">关闭</tl-button>
      </view>
      <view class="monthly-report-card">
        <view class="report-card-banner">
          <text class="report-brand">OurNest · 生活月刊</text>
          <text class="report-period">{{rangeLabel}}</text>
        </view>
        <view class="report-card-hero">
          <text class="report-hero-label">家庭总支出</text>
          <text class="report-hero-amount t-num">¥{{dashboardView.totalText}}</text>
          <text class="report-hero-sub">共 {{dashboardView.recordCount}} 笔 · 日均 ¥{{dashboardView.dailyAverageText}}</text>
        </view>
        <view wx:if="{{dashboardView.editorialSummary}}" class="report-narrative-quote">
          <text>“{{dashboardView.editorialSummary}}”</text>
        </view>
        <view wx:if="{{dashboardView.categories.length}}" class="report-top-categories">
          <text class="report-section-label">生活大头前三项</text>
          <view wx:for="{{dashboardView.categories}}" wx:key="key" wx:if="{{index < 3}}" class="report-cat-row">
            <view class="report-cat-left">
              <view class="category-chart-dot" style="background: {{item.chartColor}};">
              </view>
              <text class="report-cat-name">{{item.name}}</text>
            </view>
            <text class="report-cat-val t-num">¥{{item.amountText}} ({{item.rate}}%)</text>
          </view>
        </view>
        <view wx:if="{{family && family.payers.length}}" class="report-payers-summary">
          <text class="report-section-label">全家付款贡献</text>
          <view class="report-payers-pills">
            <text wx:for="{{family.payers}}" wx:key="openid" class="report-payer-item">{{item.name}} {{item.rate}}% (¥{{item.amountText}})</text>
          </view>
        </view>
      </view>
      <view class="monthly-report-actions">
        <tl-button variant="primary" size="medium" bind:tap="copyMonthlyReportText">一键复制月报文本</tl-button>
      </view>
    </view>
  </tl-bottom-sheet>
  <tl-bottom-sheet visible="{{isModeSheetVisible}}" bind:close="closeModeSheet">
    <view class="analysis-mode-sheet">
      <view class="analysis-mode-sheet__title">选择分析类型</view>
      <view class="analysis-mode-list">
        <view wx:for="{{modeOptions}}" wx:key="value" class="analysis-mode-option {{item.value === mode ? 'is-active' : ''}}" data-mode="{{item.value}}" bindtap="chooseMode">
          <text>{{item.label}}</text>
          <tl-icon wx:if="{{item.value === mode}}" name="check-line" size="32" colorKey="primary">
          </tl-icon>
        </view>
      </view>
    </view>
  </tl-bottom-sheet>
  <tl-ledger-switcher id="ledger-switcher" visible="{{isLedgerSwitcherVisible}}" ledgers="{{ledgerOptions}}" selected-id="{{ledgerId}}" title="切换账本分析" loading="{{isLoadingLedgers}}" error="{{ledgerLoadError}}" bind:select="chooseViewLedger" bind:close="closeLedgerSwitcher" bind:retry="switchLedger">
  </tl-ledger-switcher>
  <tl-dialog visible="{{isQuestionDialogVisible}}" bind:close="closeQuestionDialog">
    <view class="analysis-question-dialog">
      <view class="analysis-question-dialog__header">
        <text class="analysis-question-dialog__title">{{questionDialogTitle}}</text>
        <view class="analysis-question-dialog__close" bindtap="closeQuestionDialog">
          <tl-icon name="close-line" size="32" colorKey="mutedText">
          </tl-icon>
        </view>
      </view>
      <text class="analysis-question-dialog__copy">{{questionDialogContent}}</text>
    </view>
  </tl-dialog>
</view>
