.tl-budget-progress {
  width: 100%;
}
.tl-budget-progress__track {
  height: 14rpx;
  overflow: hidden;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-surface-soft);
}
.tl-budget-progress__bar {
  height: 100%;
  border-radius: inherit;
  background: var(--tl-palette-green-500);
}
.tl-budget-progress__bar.attention {
  background: var(--tl-color-warning-alt);
}
.tl-budget-progress__bar.warning {
  background: var(--tl-color-warning-accent);
}
.tl-budget-progress__bar.danger {
  background: var(--tl-color-danger);
}
