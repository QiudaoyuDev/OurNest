.tl-record-form {
  padding: 30rpx;
  border: var(--tl-border-width) solid var(--tl-color-border-subtle);
  border-radius: var(--tl-radius-card);
  box-sizing: border-box;
  background: var(--tl-color-surface);
  box-shadow: var(--tl-shadow-sm);
}
.tl-record-form__amount {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: var(--tl-border-width) solid var(--tl-color-divider-warm);
  color: var(--tl-color-primary);
}
.tl-record-form__amount text {
  font-size: var(--tl-font-size-2xl);
  font-weight: var(--tl-font-weight-bold);
}
.tl-record-form__amount input {
  flex: 1;
  height: 94rpx;
  padding-left: 18rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-data-xl);
  font-weight: var(--tl-font-weight-bold);
}
.tl-record-form__result {
  margin-top: 12rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  text-align: right;
}
.tl-record-form__quick {
  width: 100%;
  white-space: nowrap;
  padding: 20rpx 0;
}
.tl-record-form__quick-list {
  display: inline-flex;
  min-width: 100%;
}
.tl-record-form__quick-list > view,
.tl-record-form__tag-list view {
  display: inline-flex;
  margin-right: 14rpx;
  padding: 14rpx 22rpx;
  border-radius: var(--tl-radius-pill);
  color: var(--tl-color-text-tertiary);
  background: var(--tl-palette-warm-100);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}
.tl-record-form__field,
.tl-record-form__tags {
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 96rpx;
  border-top: var(--tl-border-width) solid var(--tl-color-divider-warm);
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
}
.tl-record-form__field > text,
.tl-record-form__tags > text {
  width: 96rpx;
  flex: 0 0 96rpx;
}
.tl-record-form__field picker,
.tl-record-form__field input,
.tl-record-form__field textarea,
.tl-record-form__tag-content {
  min-width: 0;
  flex: 1;
}
.tl-record-form__field > .tl-record-form__value {
  display: block;
  min-width: 0;
  flex: 1;
}
.tl-record-form__value,
.tl-record-form__field input,
.tl-record-form__field textarea {
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  text-align: right;
}
.tl-record-form__field--note {
  align-items: flex-start;
  padding: 22rpx 0;
}
.tl-record-form__note {
  height: 126rpx;
  box-sizing: border-box;
  padding: 12rpx 0;
  line-height: 42rpx;
  text-align: left !important;
}
.tl-record-form__tags {
  align-items: flex-start;
  padding: 26rpx 0;
}
.tl-record-form__tag-composer {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  padding: 8rpx;
  border: var(--tl-border-width) solid var(--tl-color-border-warm);
  border-radius: var(--tl-radius-control);
  background: var(--tl-palette-warm-100);
}
.tl-record-form__tags input {
  min-width: 0;
  flex: 1;
  height: 66rpx;
  padding: 0 14rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
}
.tl-record-form__tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}
.tl-record-form__tag-list view {
  margin-right: 0;
}
.tl-record-form__add {
  height: 58rpx;
  padding: 0 22rpx;
  border-radius: var(--tl-radius-control);
  flex: 0 0 auto;
  color: var(--tl-color-text-inverse);
  background: var(--tl-color-primary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  line-height: 58rpx;
}
.tl-record-form__amount-value {
  flex: 1;
  min-width: 0;
  height: 94rpx;
  padding-left: var(--tl-space-sm);
  overflow: hidden;
  color: var(--tl-color-text);
  font-size: var(--tl-font-data-xl);
  font-weight: var(--tl-font-weight-bold);
  line-height: 94rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tl-record-form__amount-value.is-placeholder {
  color: var(--tl-color-tab-inactive);
}

.tl-record-form__keypad-mask {
  position: fixed;
  inset: 0;
  z-index: var(--tl-z-mask);
  background: rgba(49, 37, 34, 0.22);
}

.tl-record-form__keypad {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: var(--tl-z-keyboard);
  padding: 18rpx var(--tl-space-md) calc(18rpx + env(safe-area-inset-bottom));
  border-top: var(--tl-border-width) solid var(--tl-color-border);
  background: rgba(255, 247, 242, 0.98);
}

.tl-record-form__keypad-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 4rpx 14rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.tl-record-form__keypad-close {
  width: 180rpx;
  flex: 0 0 auto;
}

.tl-record-form__keypad-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.keypad-key {
  height: 78rpx;
  border: var(--tl-border-width) solid var(--tl-color-border-subtle);
  border-radius: var(--tl-radius-control);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tl-color-surface);
  box-shadow: var(--tl-shadow-sm);
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
  transition:
    transform var(--tl-duration-fast) ease,
    background var(--tl-duration-fast) ease;
}

.keypad-key:active {
  background: var(--tl-color-primary-soft);
  transform: scale(0.94);
}

.tl-record-form--quick {
  padding: 0;
  border: none;
  background: transparent;
}

.tl-record-form__quick-bar {
  width: 100%;
  margin-bottom: 12rpx;
}

.tl-record-form__quick-grid {
  display: grid;
  gap: 12rpx;
  width: 100%;
}

.tl-record-form__quick-grid.is-4col {
  grid-template-columns: repeat(4, 1fr);
}

.tl-record-form__quick-grid.is-5col {
  grid-template-columns: repeat(5, 1fr);
}

.quick-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border: var(--tl-border-width) solid var(--tl-color-border-warm);
  border-radius: var(--tl-radius-control);
  background: var(--tl-palette-warm-100);
  color: var(--tl-color-primary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  box-sizing: border-box;
  transition:
    transform 0.08s ease,
    background-color 0.08s ease;
}

.quick-chip:active {
  background: var(--tl-color-primary-soft);
  transform: scale(0.96);
}

.tl-record-form__calc-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.calc-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
  min-width: 72rpx;
  padding: 0 18rpx;
  border: var(--tl-border-width) solid var(--tl-color-border);
  border-radius: var(--tl-radius-control);
  background: var(--tl-color-surface);
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.calc-btn:active {
  background: var(--tl-color-primary-soft);
  color: var(--tl-color-primary);
}

.calc-btn--clear {
  margin-left: auto;
  font-size: var(--tl-font-caption);
  color: var(--tl-color-text-tertiary);
}

.tl-record-form__keypad-grid--3col {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.tl-record-form__keypad-grid--3col .keypad-key {
  height: 80rpx;
}

.tl-record-form__submit-bar {
  margin-top: 12rpx;
  height: 80rpx;
}

.tl-record-form__submit-bar--split {
  display: flex;
  gap: 12rpx;
}

.tl-record-form__submit-bar--split .keypad-submit-btn {
  flex: 1;
}

.keypad-submit-btn.keypad-submit-btn--continue {
  border: var(--tl-border-width) solid var(--tl-color-primary);
  background: var(--tl-color-primary-soft);
  color: var(--tl-color-primary);
}

.keypad-submit-btn.keypad-submit-btn--continue:active {
  background: var(--tl-palette-warm-300);
}

.keypad-submit-btn {
  width: 100%;
  height: 80rpx;
  border-radius: var(--tl-radius-control);
  background: var(--tl-color-primary);
  color: var(--tl-color-text-inverse);
  font-size: var(--tl-font-action);
  font-weight: var(--tl-font-weight-bold);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: normal;
  padding: 0;
  margin: 0;
}

.keypad-submit-btn::after {
  border: 0;
}

.keypad-submit-btn.is-saving {
  background: var(--tl-color-primary);
  color: var(--tl-color-text-inverse);
  opacity: 0.48;
  transform: none;
}

.keypad-submit-btn--equal {
  background: var(--tl-palette-warm-100);
  color: var(--tl-color-text);
}

.keypad-key--backspace,
.keypad-key--clear {
  background: var(--tl-palette-warm-100);
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body);
}

.keypad-key--equal,
.keypad-key--submit {
  background: var(--tl-color-primary);
  color: var(--tl-color-text-inverse);
  font-size: var(--tl-font-body);
}

.tl-record-form__keypad--quick {
  box-sizing: border-box;
  max-height: 78vh;
  overflow-y: auto;
  animation: record-panel-up var(--tl-duration-normal) ease-out both;
}

.tl-record-form__keypad-space {
  height: calc(720rpx + env(safe-area-inset-bottom));
}

@keyframes record-panel-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.tl-record-form__keypad-grid--four {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
}
.tl-record-form__keypad-grid--four .keypad-key {
  height: 68rpx;
}
.keypad-key--operator {
  color: var(--tl-color-primary);
  background: var(--tl-palette-warm-100);
}

.tl-record-form__keypad-grid--four .keypad-key--tall {
  grid-row: span 2;
  height: auto;
}
