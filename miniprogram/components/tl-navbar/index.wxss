.tl-navbar {
  display: block;
  flex: 0 0 auto;
  width: 100%;
  margin-bottom: 22rpx;
  background: transparent;
}

.nav-row,
.nav-brand,
.nav-brand-ledger-flow {
  display: flex;
  align-items: center;
}

.nav-row {
  position: relative;
  justify-content: space-between;
}

.nav-brand-ledger-flow {
  display: inline-flex;
  align-items: center;
  max-width: 440rpx;
  height: 68rpx;
  padding: 0 18rpx 0 12rpx;
  background: rgba(255, 255, 255, 0.85);
  border: var(--tl-border-width) solid var(--tl-color-border-subtle);
  border-radius: var(--tl-radius-pill);
  box-shadow: var(--tl-shadow-sm);
  cursor: pointer;
  transition:
    transform var(--tl-duration-fast) ease,
    opacity var(--tl-duration-fast) ease;
}

.nav-brand-ledger-flow:active {
  transform: scale(0.96);
  opacity: 0.92;
}

.brand-ledger-name {
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
}

.nav-brand-ledger-flow .brand-mark {
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  margin-right: 10rpx;
}

.brand-ledger-arrow {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  margin-left: 6rpx;
}

.nav-brand,
.nav-right {
  width: 220rpx;
  min-width: 0;
}

.brand-mark,
.back-button {
  position: relative;
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  margin-right: 12rpx;
  border-radius: var(--tl-radius-control);
  display: flex;
  align-items: center;
  justify-content: center;
}

.brand-mark {
  overflow: visible;
}

.back-button {
  background: rgba(255, 255, 255, 0.85);
  border: var(--tl-border-width) solid var(--tl-color-border-subtle);
  border-radius: var(--tl-radius-pill);
  box-shadow: var(--tl-shadow-sm);
  color: var(--tl-color-primary);
  font-size: var(--tl-font-data);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1;
  transition: transform var(--tl-duration-fast) ease;
}

.back-button:active {
  transform: scale(0.92);
}

.brand-name {
  color: var(--tl-color-text);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  white-space: nowrap;
}

.nav-center {
  position: absolute;
  left: 50%;
  max-width: 250rpx;
  transform: translateX(-50%);
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.back-button {
  box-sizing: border-box;
  text-align: center;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.back-button tl-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}
