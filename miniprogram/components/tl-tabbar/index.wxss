.tl-tabbar {
  position: relative;
  z-index: var(--tl-z-bottom);
  flex: 0 0 auto;
  width: calc(100% + 56rpx);
  margin: 12rpx -28rpx 0;
  padding: 0 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.94);
  border-top: var(--tl-border-width) solid var(--tl-color-border-subtle);
  box-shadow: var(--tl-shadow-tabbar);
}

.tabbar-shell {
  position: relative;
  min-height: var(--tl-tabbar-shell-height);
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  align-items: center;
}

.tab-item {
  min-width: 0;
  height: 96rpx;
  color: var(--tl-color-tab-inactive);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-medium);
  transition: color var(--tl-duration-fast) ease;
}

.tab-item:nth-child(1) {
  grid-column: 1;
}
.tab-item:nth-child(2) {
  grid-column: 2;
}
.tab-item:nth-child(4) {
  grid-column: 4;
}
.tab-item:nth-child(5) {
  grid-column: 5;
}

.tab-item.active {
  color: var(--tl-color-primary);
  font-weight: var(--tl-font-weight-bold);
}

.record-hub {
  grid-column: 3;
  justify-self: center;
  width: 104rpx;
  height: 104rpx;
  margin-top: -38rpx;
  border-radius: var(--tl-radius-pill);
  background: linear-gradient(
    135deg,
    var(--tl-palette-our-nest-400) 0%,
    var(--tl-color-primary) 100%
  );
  border: 6rpx solid var(--tl-palette-white);
  box-shadow: var(--tl-shadow-glow-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    transform var(--tl-duration-fast) cubic-bezier(0.34, 1.56, 0.64, 1),
    box-shadow var(--tl-duration-fast) ease;
}

.record-hub:active {
  transform: scale(0.92) translateY(2rpx);
}

.record-hub.readonly {
  background: var(--tl-color-tab-divider);
}
.tab-icon,
.hub-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  overflow: visible;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  transition: transform var(--tl-duration-fast) cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-item.active .tab-icon {
  transform: translateY(-4rpx) scale(1.05);
}

.hub-icon {
  width: 54rpx;
  height: 54rpx;
}

.tab-icon tl-icon,
.hub-icon tl-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}
