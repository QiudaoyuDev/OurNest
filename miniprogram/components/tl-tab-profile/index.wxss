.profile-hero-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx 30rpx 28rpx;
  background: var(--tl-color-primary-soft);
}

.profile-hero-card::after {
  content: "";
  position: absolute;
  right: -86rpx;
  top: -96rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(240, 68, 47, 0.1);
}

.identity-row,
.stats-grid,
.tool-grid {
  position: relative;
  z-index: 1;
}

.identity-row {
  min-height: 120rpx;
  display: flex;
  align-items: center;
  padding-right: 74rpx;
}

.avatar-img {
  width: 116rpx;
  height: 116rpx;
  flex: 0 0 116rpx;
  border-radius: var(--tl-radius-card);
  background: var(--tl-color-primary-soft);
}

.identity-main {
  flex: 1;
  min-width: 0;
  padding-left: 22rpx;
}

.user-name-row {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.user-name {
  min-width: 0;
  color: var(--tl-color-text);
  font-size: var(--tl-font-data);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stat-label {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.35;
}

.profile-setting {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  z-index: 2;
  width: 58rpx;
  height: 58rpx;
  border-radius: var(--tl-radius-control);
  background: rgba(255, 253, 251, 0.86);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  margin-top: 26rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(240, 68, 47, 0.06);
}

.stat-item {
  position: relative;
  min-width: 0;
  padding: 2rpx 10rpx;
  text-align: center;
}

.stat-value {
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1;
}

.stat-label {
  margin-top: 10rpx;
}

.profile-setting tl-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}
.tools-panel,
.more-panel {
  margin-top: 26rpx;
  padding: 28rpx 24rpx 8rpx;
  background: rgba(255, 253, 252, 0.94);
}

.section-title {
  margin-bottom: 18rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.2;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx 6rpx;
}

.tool-tile {
  position: relative;
  min-width: 0;
  min-height: 128rpx;
  padding: 14rpx 4rpx 12rpx;
  border-radius: var(--tl-radius-control);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.tool-badge {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  font-size: var(--tl-font-caption-compact);
  line-height: 1;
  padding: 4rpx 8rpx;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-surface-muted);
  color: var(--tl-color-text-tertiary);
  font-weight: var(--tl-font-weight-bold);
}

.tool-tile:active,
.function-row:active {
  background: var(--tl-color-surface-warm);
}

.tool-icon,
.function-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: var(--tl-radius-md);
  color: var(--tl-color-primary);
  background: var(--tl-color-primary-soft);
  box-shadow: var(--tl-shadow-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-chip-orange {
  background: var(--tl-color-chip-orange) !important;
}
.icon-chip-blue {
  background: var(--tl-color-chip-blue) !important;
}
.icon-chip-amber {
  background: var(--tl-color-chip-amber) !important;
}
.icon-chip-purple {
  background: var(--tl-color-chip-purple) !important;
}
.icon-chip-sky {
  background: var(--tl-color-chip-sky) !important;
}
.icon-chip-green {
  background: var(--tl-color-chip-green) !important;
}

.tool-title {
  width: 100%;
  margin-top: 10rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.25;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.function-list {
  margin-top: 22rpx;
  border-top: 1rpx solid var(--tl-color-divider);
}

.function-row {
  min-height: var(--tl-list-row-height);
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--tl-color-divider);
  display: flex;
  align-items: center;
}

.function-row:last-child {
  border-bottom: none;
}

.function-main {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.function-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.function-title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.25;
}

.status-badge {
  font-size: var(--tl-font-caption-compact);
  line-height: 1;
  padding: 4rpx 10rpx;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-surface-muted);
  color: var(--tl-color-text-tertiary);
  font-weight: var(--tl-font-weight-bold);
}

.function-tip {
  margin-top: 8rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.function-arrow {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.function-value {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.25;
}

.tool-icon tl-icon,
.function-icon tl-icon,
.function-arrow tl-icon,
.profile-setting tl-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}
.logout-button {
  margin-top: var(--tl-space-lg);
}

:host {
  display: flex;
  width: 100%;
  min-height: 0;
  flex: 1 1 0;
  overflow: hidden;
}

.tab-panel {
  display: flex;
  width: 100%;
  min-height: 0;
  flex: 1 1 0;
  flex-direction: column;
  overflow: hidden;
}

.page-scroll {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex: 1 1 0;
}

.page-content {
  width: 100%;
  min-height: 100%;
  padding-bottom: 24px;
}

/* 退出登录 Dialog 样式 */
.custom-dialog-panel {
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 14rpx;
}
.dialog-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--tl-color-primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}
.dialog-icon-wrap.danger-wrap {
  background: var(--tl-color-danger-soft);
}
.dialog-title {
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
  color: var(--tl-color-text);
}
.dialog-desc {
  font-size: var(--tl-font-body-sm);
  color: var(--tl-color-text-secondary);
  line-height: 1.5;
  margin-bottom: 16rpx;
}
.dialog-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  width: 100%;
}
