<view class="tab-panel profile-page">
  <scroll-view class="page-scroll" scroll-y="{{true}}" enhanced="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
    <view class="page-content">
      <view class="profile-hero-card card fade-up">
        <view class="profile-setting" bindtap="handleIdentityTap">
          <tl-icon name="settings-3-line" size="30" colorKey="primary">
          </tl-icon>
        </view>
        <view class="identity-row" bindtap="handleIdentityTap">
          <image class="avatar-img" src="{{userAvatar}}" mode="aspectFill">
          </image>
          <view class="identity-main">
            <view class="user-name-row">
              <text class="user-name">{{userName}}</text>
            </view>
          </view>
        </view>
        <view class="stats-grid">
          <view class="stat-item">
            <view class="stat-value">{{usageDays}}</view>
            <view class="stat-label">使用天数</view>
          </view>
          <view class="stat-item">
            <view class="stat-value">{{recordCount}}</view>
            <view class="stat-label">记录笔数</view>
          </view>
          <view class="stat-item">
            <view class="stat-value">{{ledgerCount}}</view>
            <view class="stat-label">账本总数</view>
          </view>
        </view>
      </view>
      <view class="tools-panel card fade-up">
        <view class="section-title">账本与协作</view>
        <view class="function-list">
          <view class="function-row" bindtap="ledgerSettings">
            <view class="function-icon icon-chip-orange">
              <tl-icon name="settings-3-line" size="32" color="#e86a33">
              </tl-icon>
            </view>
            <view class="function-main">
              <view class="function-title">账本管理</view>
              <view class="function-tip">管理与切换当前使用账本</view>
            </view>
            <view class="function-arrow">
              <tl-icon name="arrow-right-s-line" size="32" colorKey="tertiary">
              </tl-icon>
            </view>
          </view>
          <view class="function-row" bindtap="manageMembers">
            <view class="function-icon icon-chip-blue">
              <tl-icon name="team-line" size="32" color="#4f46e5">
              </tl-icon>
            </view>
            <view class="function-main">
              <view class="function-title">成员管理</view>
              <view class="function-tip">查看家庭与共享协作者</view>
            </view>
            <view class="function-arrow">
              <tl-icon name="arrow-right-s-line" size="32" colorKey="tertiary">
              </tl-icon>
            </view>
          </view>
          <view class="function-row" bindtap="joinLedger">
            <view class="function-icon icon-chip-amber">
              <tl-icon name="coupon-3-line" size="32" color="#d97706">
              </tl-icon>
            </view>
            <view class="function-main">
              <view class="function-title">邀请码</view>
              <view class="function-tip">凭邀请码加入对方的小窝账本</view>
            </view>
            <view class="function-arrow">
              <tl-icon name="arrow-right-s-line" size="32" colorKey="tertiary">
              </tl-icon>
            </view>
          </view>
        </view>
      </view>
      <view class="tools-panel card fade-up">
        <view class="section-title">记账偏好配置</view>
        <view class="function-list">
          <view class="function-row" bindtap="manageCategories">
            <view class="function-icon icon-chip-purple">
              <tl-icon name="price-tag-3-line" size="32" color="#9333ea">
              </tl-icon>
            </view>
            <view class="function-main">
              <view class="function-title">分类管理</view>
              <view class="function-tip">自定义支出与收入类目</view>
            </view>
            <view class="function-arrow">
              <tl-icon name="arrow-right-s-line" size="32" colorKey="tertiary">
              </tl-icon>
            </view>
          </view>
          <view class="function-row" bindtap="manageAccounts">
            <view class="function-icon icon-chip-sky">
              <tl-icon name="bank-card-line" size="32" color="#0284c7">
              </tl-icon>
            </view>
            <view class="function-main">
              <view class="function-title">支付账户</view>
              <view class="function-tip">配置微信、支付宝与常用银行卡</view>
            </view>
            <view class="function-arrow">
              <tl-icon name="arrow-right-s-line" size="32" colorKey="tertiary">
              </tl-icon>
            </view>
          </view>
          <view wx:if="{{!readonly && currentLedger.id}}" class="function-row" bindtap="importBill">
            <view class="function-icon">
              <tl-icon name="file-upload-line" size="32" colorKey="primary">
              </tl-icon>
            </view>
            <view class="function-main">
              <view class="function-title">导入账单</view>
              <view class="function-tip">导入到 {{currentLedger.name}}</view>
            </view>
            <view class="function-arrow">
              <tl-icon name="arrow-right-s-line" size="32" colorKey="tertiary">
              </tl-icon>
            </view>
          </view>
          <view wx:if="{{!currentLedger.id}}" class="function-row" bindtap="createLedger">
            <view class="function-icon">
              <tl-icon name="file-upload-line" size="32" colorKey="primary">
              </tl-icon>
            </view>
            <view class="function-main">
              <view class="function-title">导入账单</view>
              <view class="function-tip">先创建账本再导入</view>
            </view>
            <view class="function-arrow">
              <tl-icon name="arrow-right-s-line" size="32" colorKey="tertiary">
              </tl-icon>
            </view>
          </view>
          <view class="function-row" bindtap="manageQuickAmounts">
            <view class="function-icon icon-chip-green">
              <tl-icon name="wallet-3-line" size="32" color="#0ea569">
              </tl-icon>
            </view>
            <view class="function-main">
              <view class="function-title">快捷金额</view>
              <view class="function-tip">设置数字键盘上的高频金额</view>
            </view>
            <view class="function-arrow">
              <tl-icon name="arrow-right-s-line" size="32" colorKey="tertiary">
              </tl-icon>
            </view>
          </view>
        </view>
      </view>
      <view class="more-panel card fade-up">
        <view class="section-title">其他</view>
        <view class="function-list">
          <view class="function-row" bindtap="syncData">
            <view class="function-icon icon-chip-blue">
              <tl-icon name="refresh-line" size="30" color="#3b82f6">
              </tl-icon>
            </view>
            <view class="function-main">
              <view class="function-title">同步数据</view>
              <view class="function-tip">{{syncing ? '正在更新账号、账本和分类...' : lastSyncedText}}</view>
            </view>
            <view class="function-arrow">
              <tl-icon name="loader-4-line" size="32" colorKey="primary" wx:if="{{syncing}}">
              </tl-icon>
              <tl-icon name="arrow-right-s-line" size="32" colorKey="tertiary" wx:else>
              </tl-icon>
            </view>
          </view>
          <!-- 暂时隐藏意见反馈和更新日志入口。 -->
          <view wx:if="{{false}}" class="function-row" bindtap="feedback">
            <view class="function-icon">
              <tl-icon name="message-3-line" size="30" colorKey="primary">
              </tl-icon>
            </view>
            <view class="function-main">
              <view class="function-title">意见反馈</view>
              <view class="function-tip">告诉我们哪里还可以更好用</view>
            </view>
            <view class="function-arrow">
              <tl-icon name="arrow-right-s-line" size="32" colorKey="primary">
              </tl-icon>
            </view>
          </view>
          <view wx:if="{{false}}" class="function-row" bindtap="viewChangelog">
            <view class="function-icon">
              <tl-icon name="history-line" size="30" colorKey="primary">
              </tl-icon>
            </view>
            <view class="function-main">
              <view class="function-title-row">
                <view class="function-title">更新日志</view>
                <text class="status-badge">规划中</text>
              </view>
              <view class="function-tip">查看最近更新</view>
            </view>
            <view class="function-arrow">
              <tl-icon name="arrow-right-s-line" size="32" colorKey="primary">
              </tl-icon>
            </view>
          </view>
          <view class="function-row" bindtap="viewVersion">
            <view class="function-icon">
              <tl-icon name="information-line" size="30" colorKey="primary">
              </tl-icon>
            </view>
            <view class="function-main">
              <view class="function-title">版本号</view>
              <view class="function-tip">当前版本</view>
            </view>
            <view class="function-value">{{version}}</view>
          </view>
        </view>
      </view>
      <tl-button class="logout-button" variant="danger" block="{{true}}" bind:tap="logout">退出账号</tl-button>
    </view>
  </scroll-view>
  <tl-dialog visible="{{logoutDialogVisible}}" bind:close="closeLogoutDialog">
    <view class="custom-dialog-panel">
      <view class="dialog-icon-wrap danger-wrap">
        <tl-icon name="logout-box-r-line" size="48" color="#f0442f">
        </tl-icon>
      </view>
      <view class="dialog-title">退出账号</view>
      <view class="dialog-desc">退出后，本机将清除当前微信登录态，下次打开需重新点击微信授权登录。</view>
      <view class="dialog-actions">
        <tl-button variant="secondary" block="{{true}}" bind:tap="closeLogoutDialog">取消</tl-button>
        <tl-button block="{{true}}" bind:tap="confirmLogout">退出账号</tl-button>
      </view>
    </view>
  </tl-dialog>
</view>
