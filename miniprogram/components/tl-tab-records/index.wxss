.records-toolbar {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
}

.month-switcher {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 76rpx;
  border-radius: var(--tl-radius-pill);
  border: var(--tl-border-width) solid var(--tl-color-border-subtle);
  background: rgba(255, 255, 255, 0.88);
  overflow: hidden;
}

.month-picker-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex: 1 1 auto;
  height: 76rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.month-picker-btn:active {
  background: var(--tl-color-primary-soft);
}

.month-text {
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}

.month-nav {
  width: 88rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--tl-color-primary-ink);
  font-size: var(--tl-font-data);
  font-weight: var(--tl-font-weight-bold);
  flex: 0 0 88rpx;
}

.month-nav:active {
  background: var(--tl-color-primary-soft);
}

.month-text {
  min-width: 140rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  text-align: center;
}

.filter-panel {
  position: sticky;
  top: 0;
  z-index: 8;
  margin: 0 -8rpx 24rpx;
  padding: 12rpx 8rpx 16rpx;
  background: rgba(255, 247, 242, 0.5);
  backdrop-filter: blur(18rpx);
}

.segmented {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  padding: 8rpx;
  border-radius: var(--tl-radius-pill);
  background: rgba(255, 255, 255, 0.88);
  border: var(--tl-border-width) solid var(--tl-color-border-subtle);
}

.seg-item {
  height: 64rpx;
  border-radius: var(--tl-radius-pill);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.seg-item.active {
  color: var(--tl-color-text-inverse);
  background: var(--tl-color-primary);
}

.month-brief {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 16rpx 24rpx;
  background: var(--tl-color-surface);
  border-radius: var(--tl-radius-md);
  border: var(--tl-border-width) solid var(--tl-color-border-subtle);
}

.month-brief > view {
  display: flex;
  align-items: baseline;
}

.brief-label {
  margin-right: 8rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.brief-income,
.brief-expense,
.brief-count {
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.brief-income {
  color: var(--tl-color-income);
}
.brief-expense {
  color: var(--tl-color-primary-ink);
}
.brief-count {
  color: var(--tl-color-text-muted);
}

.timeline {
  overflow: visible;
}

.day-section {
  margin-bottom: 26rpx;
  border-radius: var(--tl-radius-md);
  background: rgba(255, 255, 255, 0.92);
  border: var(--tl-border-width) solid var(--tl-color-border-subtle);
  overflow: visible;
}

.day-sticky {
  position: sticky;
  top: 146rpx;
  z-index: 6;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 26rpx 18rpx;
  border-radius: var(--tl-radius-md) var(--tl-radius-md) 0 0;
  background: rgba(255, 253, 251, 0.94);
  backdrop-filter: blur(16rpx);
  border-bottom: 1rpx solid var(--tl-color-divider);
}

.day-title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}

.day-subtitle {
  margin-top: 4rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.day-total {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.day-income {
  color: var(--tl-color-income);
}
.day-expense {
  color: var(--tl-color-primary-ink);
}

.record-row {
  display: flex;
  align-items: center;
  min-height: var(--tl-list-row-height);
  padding: 20rpx 26rpx;
  border-bottom: 1rpx solid var(--tl-color-divider);
}

.record-row:last-child {
  border-bottom: none;
}

.category-mark {
  width: 78rpx;
  height: 78rpx;
  flex: 0 0 78rpx;
  border-radius: var(--tl-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.category-mark.expense {
  color: var(--tl-color-primary-ink);
  background: var(--tl-color-chip-orange);
}

.category-mark.income {
  color: var(--tl-color-income);
  background: var(--tl-color-chip-green);
}

.record-main {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
}

.record-title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-amount {
  flex: 0 0 auto;
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}

.record-amount.expense {
  color: var(--tl-color-primary-ink);
}
.record-amount.income {
  color: var(--tl-color-income);
}

.record-meta {
  display: flex;
  gap: 14rpx;
  margin-top: 10rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.empty-wrap {
  min-height: 420rpx;
  padding: 20rpx;
}

.retry-button {
  display: flex;
  width: 240rpx;
  height: 76rpx;
  margin: 24rpx auto 0;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-primary);
  color: var(--tl-color-text-inverse);
  font-size: var(--tl-font-body-sm);
  align-items: center;
  justify-content: center;
  font-weight: var(--tl-font-weight-bold);
  line-height: 1;
  text-align: center;
}

/* icon optical alignment */
.month-nav {
  box-sizing: border-box;
  line-height: 1;
  text-align: center;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

/* remix icon replacements */
.ledger-chip tl-icon {
  margin-left: 10rpx;
  flex: 0 0 auto;
}

.month-nav tl-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}
.page-load-more {
  padding: 28rpx 0 46rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  text-align: center;
}

/* Keep detail rows visually aligned with the homepage record cards. */
.record-row {
  min-height: 132rpx;
  padding: 24rpx 26rpx;
}

.record-main {
  padding: 0 14rpx 0 20rpx;
}

.record-title {
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}

.record-meta {
  display: block;
  margin-top: 10rpx;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.record-note {
  margin-top: 6rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-amount {
  font-size: var(--tl-font-body);
}

.record-member {
  max-width: 260rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.record-avatar {
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 34rpx;
  border-radius: 50%;
  background: var(--tl-color-primary-soft);
}

.record-member-name {
  min-width: 0;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Align the detail fields by row: category/amount, then date/member. */
.record-row {
  align-items: flex-start;
}

.category-mark {
  margin-top: 4rpx;
}

.record-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 34rpx;
  gap: 18rpx;
}

.record-subline {
  margin-top: 10rpx;
}

.record-line .record-meta {
  margin-top: 0;
}

.record-line .record-member {
  flex: 0 0 auto;
}
.empty-actions {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.empty-actions .retry-button {
  width: auto;
  min-width: 180rpx;
  margin: 0;
  padding: 0 26rpx;
}

.empty-actions .retry-button.secondary {
  color: var(--tl-color-primary-ink);
  background: var(--tl-color-primary-soft);
}

:host {
  display: flex;
  width: 100%;
  min-height: 0;
  flex: 1 1 0;
  overflow: hidden;
}

.tab-panel {
  display: flex;
  width: 100%;
  min-height: 0;
  flex: 1 1 0;
  flex-direction: column;
  overflow: hidden;
}

.page-scroll {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex: 1 1 0;
}

.page-content {
  width: 100%;
  min-height: 100%;
  padding-bottom: 24px;
}
