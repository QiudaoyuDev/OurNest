.hero,
.summary-head,
.section-head,
.record-item,
.mini-stats,
.ledger-switch {
  display: flex;
  align-items: center;
}

.hero,
.summary-head,
.section-head {
  justify-content: space-between;
}

.hero {
  margin-bottom: 28rpx;
}

.hero-main {
  min-width: 0;
}

.ledger-switch {
  max-width: 560rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-size-2xl);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1.15;
}

.ledger-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ledger-type-tag {
  flex: 0 0 auto;
  margin-left: 12rpx;
  padding: 7rpx 14rpx;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-primary-soft);
  color: var(--tl-color-primary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1;
}

.month-line {
  margin-top: 12rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.summary-card {
  position: relative;
  overflow: hidden;
  padding: 34rpx;
  background: var(--tl-color-primary-soft);
}

.summary-glow {
  position: absolute;
  right: -72rpx;
  top: -88rpx;
  width: 230rpx;
  height: 230rpx;
  border-radius: 50%;
  background: rgba(240, 68, 47, 0.12);
}

.section-kicker,
.overview-label,
.section-tip,
.record-meta,
.mini-label,
.state-copy,
.record-limit-tip {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
}

.summary-title {
  margin-top: 10rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}

.brand-badge {
  position: relative;
  z-index: 1;
  padding: 12rpx 20rpx;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-color-surface);
  color: var(--tl-color-primary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 34rpx;
}

.overview-item {
  min-width: 0;
  padding: 22rpx 14rpx;
  border-radius: var(--tl-radius-md);
  background: rgba(255, 255, 255, 0.72);
}

.overview-value {
  margin-top: 10rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  white-space: nowrap;
}

.overview-value.income {
  color: var(--tl-color-income);
}
.overview-value.expense {
  color: var(--tl-color-primary);
}

.mini-stats {
  gap: 16rpx;
  margin-top: 22rpx;
}

.mini-stat {
  flex: 1;
  min-height: 144rpx;
  padding: 22rpx 16rpx;
  border-radius: var(--tl-radius-md);
  background: rgba(255, 253, 252, 0.9);
  border: 1rpx solid rgba(240, 68, 47, 0.08);
}

.mini-icon {
  width: 42rpx;
  height: 42rpx;
  border-radius: var(--tl-radius-xs);
  background: var(--tl-color-primary-soft);
  color: var(--tl-color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.mini-value {
  margin-top: 12rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}

.mini-label {
  margin-top: 6rpx;
}

.budget-card,
.records-card {
  margin-top: 24rpx;
  padding: 30rpx;
}

.section-title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}

.section-link,
.budget-left {
  color: var(--tl-color-primary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.record-item {
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--tl-color-border-divider);
}

.category-dot {
  width: 78rpx;
  height: 78rpx;
  flex: 0 0 78rpx;
  border-radius: var(--tl-radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  overflow: hidden;
}

.category-dot.expense {
  color: var(--tl-color-primary);
  background: var(--tl-color-primary-soft);
}
.category-dot.income {
  color: var(--tl-color-income);
  background: var(--tl-color-income-soft);
}

.record-main {
  flex: 1;
  min-width: 0;
  padding: 0 14rpx 0 20rpx;
}

.record-title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-amount {
  flex: 0 0 auto;
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}

.record-amount.expense {
  color: var(--tl-color-primary);
}
.record-amount.income {
  color: var(--tl-color-income);
}

.record-member {
  max-width: 260rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.record-avatar {
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 34rpx;
  border-radius: 50%;
  background: var(--tl-color-primary-soft);
}

.record-member-name {
  min-width: 0;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-limit-tip {
  padding-top: 20rpx;
  text-align: center;
  font-weight: var(--tl-font-weight-bold);
}

.hero-logo {
  width: 104rpx;
  height: 104rpx;
  flex: 0 0 104rpx;
}

.ledger-switch tl-icon,
.mini-icon tl-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ledger-switch tl-icon {
  flex: 0 0 auto;
  margin-left: 8rpx;
  transform: translateY(1rpx);
}

.state-card {
  padding: 34rpx;
  min-height: 440rpx;
  background: rgba(255, 253, 252, 0.94);
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.state-copy {
  max-width: 460rpx;
  margin-top: 10rpx;
  line-height: 1.5;
  text-align: center;
  font-weight: var(--tl-font-weight-bold);
}

.budget-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.budget-card-heading {
  display: flex;
  align-items: center;
  gap: var(--tl-space-xs);
}
.budget-card-title {
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
}
.budget-status-tag {
  padding: 6rpx 14rpx;
  border-radius: var(--tl-radius-pill);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  line-height: 1;
}
.budget-status-tag.safe {
  background: var(--tl-color-income-soft);
  color: var(--tl-color-income);
}
.budget-status-tag.attention {
  background: var(--tl-color-warning-soft);
  color: var(--tl-color-warning-alt);
}
.budget-status-tag.warning {
  background: var(--tl-color-warning-soft);
  color: var(--tl-color-warning-accent);
}
.budget-status-tag.danger {
  background: var(--tl-color-danger-soft);
  color: var(--tl-color-danger);
}
.budget-actions {
  display: flex;
  align-items: center;
  gap: var(--tl-space-sm);
}
.budget-action-btn {
  display: inline-flex;
  align-items: center;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-medium);
}
.budget-action-btn:active {
  color: var(--tl-color-primary);
}

.budget-hero-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: var(--tl-space-md);
}
.budget-hero-main {
  min-width: 0;
  flex: 1;
}
.budget-hero-label {
  display: block;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-medium);
}
.budget-hero-amount {
  display: flex;
  align-items: baseline;
  margin-top: 4rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-size-2xl);
  font-weight: var(--tl-font-weight-bold);
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}
.budget-hero-amount.is-danger {
  color: var(--tl-color-danger);
}
.budget-hero-amount .currency {
  font-size: var(--tl-font-heading);
  margin-right: 4rpx;
}
.budget-hero-amount .amount-num {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.budget-hero-aside {
  flex: 0 0 auto;
  margin-left: var(--tl-space-sm);
  padding-bottom: 6rpx;
}
.budget-rate-badge {
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-semibold);
  font-variant-numeric: tabular-nums;
}

.budget-progress-wrap {
  margin-top: var(--tl-space-sm);
}

.budget-metrics-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--tl-space-md);
  padding-top: var(--tl-space-sm);
  border-top: var(--tl-border-width) solid var(--tl-color-border-divider);
}
.budget-metric-item {
  min-width: 0;
  flex: 1;
}
.budget-metric-item.is-right {
  text-align: right;
}
.budget-metric-label {
  display: block;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}
.budget-metric-value {
  display: block;
  margin-top: 4rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.budget-metric-value.expense {
  color: var(--tl-color-text-secondary);
}
.budget-metric-divider {
  width: var(--tl-border-width);
  height: 36rpx;
  background: var(--tl-color-border-divider);
  margin: 0 var(--tl-space-sm);
  flex: 0 0 auto;
}

.budget-empty-state {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--tl-space-sm);
}
.budget-empty-info {
  display: flex;
  align-items: center;
  gap: var(--tl-space-sm);
  min-width: 0;
  flex: 1;
}
.budget-empty-icon {
  width: 68rpx;
  height: 68rpx;
  border-radius: var(--tl-radius-control);
  background: var(--tl-color-primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}
.budget-empty-texts {
  min-width: 0;
  flex: 1;
}
.budget-empty-title {
  display: block;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  font-weight: var(--tl-font-weight-bold);
}
.budget-empty-desc {
  display: block;
  margin-top: 4rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}
.budget-empty-action {
  flex: 0 0 auto;
}

.overview-value,
.mini-value {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.mini-stat {
  min-width: 0;
  overflow: hidden;
}
.mini-value {
  font-size: var(--tl-font-body);
}
.overview-value {
  font-size: var(--tl-font-body-sm);
}

/* Match the records-page row layout and surface optional record notes. */
.records-card .record-item {
  align-items: flex-start;
  min-height: 132rpx;
  padding: 24rpx 0;
}

.records-card .category-dot {
  margin-top: 4rpx;
}

.records-card .record-main {
  padding-right: 0;
}

.records-card .record-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 34rpx;
  gap: 18rpx;
}

.records-card .record-subline {
  margin-top: 10rpx;
}

.records-card .record-subline .record-meta {
  margin-top: 0;
}

.records-card .record-member {
  flex: 0 0 auto;
}

.records-card .record-note {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
  text-overflow: ellipsis;
  white-space: nowrap;
}
:host {
  display: flex;
  width: 100%;
  min-height: 0;
  flex: 1 1 0;
  overflow: hidden;
}

.tab-panel {
  display: flex;
  width: 100%;
  min-height: 0;
  flex: 1 1 0;
  flex-direction: column;
  overflow: hidden;
}

.page-scroll {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex: 1 1 0;
}

.page-content {
  width: 100%;
  min-height: 100%;
  padding-bottom: 24px;
}
