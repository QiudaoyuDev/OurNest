<view class="tab-panel home-page">
  <scroll-view class="page-scroll" scroll-y="{{true}}" enhanced="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
    <view class="page-content">
      <tl-skeleton wx:if="{{isLoading}}" variant="home">
      </tl-skeleton>
      <block wx:else>
        <view wx:if="{{showLedgerInfo}}" class="home-date-bar fade-up">
          <view class="home-date-main">
            <text class="home-month-text">{{monthLabel}}</text>
            <view class="ledger-type-tag" bindtap="switchLedger">
              <text>{{ledgerTypeText}}</text>
              <tl-icon name="arrow-down-s-line" size="24" colorKey="primary">
              </tl-icon>
            </view>
          </view>
        </view>
        <view wx:if="{{isNoLedger}}" class="state-card card fade-up">
          <tl-empty-state variant="no-ledger" title="还没有账本" description="创建第一个账本，开始记录生活中的每一笔收支">
            <tl-button block="{{true}}" bind:tap="goCreateLedger">创建账本</tl-button>
          </tl-empty-state>
        </view>
        <block wx:elif="{{isEmpty}}">
          <view class="state-card card fade-up">
            <tl-empty-state text="暂无数据">
            </tl-empty-state>
            <tl-button bind:tap="goRecordEdit">记一笔</tl-button>
          </view>
          <view wx:if="{{showBudget}}" class="budget-card card fade-up">
            <block wx:if="{{budgetEnabled}}">
              <view class="budget-card-header">
                <view class="budget-card-heading">
                  <text class="budget-card-title">本月预算</text>
                  <view class="budget-status-tag {{isOverBudget ? 'danger' : budgetRate >= 90 ? 'danger' : budgetRate >= 70 ? 'warning' : budgetRate >= 50 ? 'attention' : 'safe'}}">{{isOverBudget ? '已超支' : budgetRate >= 90 ? '预算预警' : budgetRate >= 70 ? '消费偏快' : budgetRate >= 50 ? '已用过半' : '预算充足'}}</view>
                </view>
                <view class="budget-actions">
                  <view class="budget-action-btn" bindtap="goBudgetRecords">
                    <text>支出明细</text>
                    <tl-icon name="arrow-right-s-line" size="24" colorKey="tertiary">
                    </tl-icon>
                  </view>
                  <view wx:if="{{canManageBudget}}" class="budget-action-btn" bindtap="goBudgetSettings">
                    <text>设置</text>
                  </view>
                </view>
              </view>
              <view class="budget-hero-row">
                <view class="budget-hero-main">
                  <text class="budget-hero-label">{{isOverBudget ? '已超支' : '剩余可用'}}</text>
                  <view class="budget-hero-amount {{isOverBudget ? 'is-danger' : ''}}">
                    <text class="currency">{{isOverBudget ? '-¥' : '¥'}}</text>
                    <text class="amount-num">{{budgetLeftAbs}}</text>
                  </view>
                </view>
                <view class="budget-hero-aside">
                  <text class="budget-rate-badge">已用 {{budgetRateText}}%</text>
                </view>
              </view>
              <view class="budget-progress-wrap">
                <tl-budget-progress enabled="{{budgetEnabled}}" rate="{{budgetRate}}">
                </tl-budget-progress>
              </view>
              <view class="budget-metrics-row">
                <view class="budget-metric-item">
                  <text class="budget-metric-label">总预算</text>
                  <text class="budget-metric-value">¥{{budget}}</text>
                </view>
                <view class="budget-metric-divider">
                </view>
                <view class="budget-metric-item is-right">
                  <text class="budget-metric-label">已支出</text>
                  <text class="budget-metric-value expense">¥{{monthExpense}}</text>
                </view>
              </view>
            </block>
            <view wx:else class="budget-empty-state">
              <view class="budget-empty-info">
                <view class="budget-empty-icon">
                  <tl-icon name="wallet-3-line" size="38" colorKey="primary">
                  </tl-icon>
                </view>
                <view class="budget-empty-texts">
                  <text class="budget-empty-title">本月预算未开启</text>
                  <text class="budget-empty-desc">设定月度支出预算，随时掌控消费节奏</text>
                </view>
              </view>
              <view wx:if="{{canManageBudget}}" class="budget-empty-action">
                <tl-button size="small" variant="secondary" bind:tap="goBudgetSettings">设置预算</tl-button>
              </view>
            </view>
          </view>
        </block>
        <view wx:elif="{{isError}}" class="state-card card fade-up">
          <tl-empty-state text="数据加载失败，请稍后重试">
          </tl-empty-state>
          <tl-button variant="secondary" bind:tap="bootstrap">重新加载</tl-button>
        </view>
        <block wx:else>
          <view wx:if="{{showBudget && budgetEnabled}}" class="budget-card card fade-up">
            <view class="budget-card-header">
              <view class="budget-card-heading">
                <text class="budget-card-title">本月预算</text>
                <view class="budget-status-tag {{isOverBudget ? 'danger' : budgetRate >= 90 ? 'danger' : budgetRate >= 70 ? 'warning' : budgetRate >= 50 ? 'attention' : 'safe'}}">{{isOverBudget ? '已超支' : budgetRate >= 90 ? '预算预警' : budgetRate >= 70 ? '消费偏快' : budgetRate >= 50 ? '已用过半' : '预算充足'}}</view>
              </view>
              <view class="budget-actions">
                <view class="budget-action-btn" bindtap="goBudgetRecords">
                  <text>支出明细</text>
                  <tl-icon name="arrow-right-s-line" size="24" colorKey="tertiary">
                  </tl-icon>
                </view>
                <view wx:if="{{canManageBudget}}" class="budget-action-btn" bindtap="goBudgetSettings">
                  <text>设置</text>
                </view>
              </view>
            </view>
            <view class="budget-hero-row">
              <view class="budget-hero-main">
                <text class="budget-hero-label">{{isOverBudget ? '已超支' : '剩余可用'}}</text>
                <view class="budget-hero-amount {{isOverBudget ? 'is-danger' : ''}}">
                  <text class="currency">{{isOverBudget ? '-¥' : '¥'}}</text>
                  <text class="amount-num">{{budgetLeftInteger || budgetLeftAbs}}</text>
                  <text wx:if="{{budgetLeftDecimal}}" class="amount-decimal">{{budgetLeftDecimal}}</text>
                </view>
              </view>
              <view class="budget-hero-aside">
                <text class="budget-rate-badge">已用 {{budgetRateText}}%</text>
              </view>
            </view>
            <view class="budget-progress-wrap">
              <tl-budget-progress enabled="{{budgetEnabled}}" rate="{{budgetRate}}">
              </tl-budget-progress>
            </view>
            <view class="budget-metrics-row">
              <view class="budget-metric-item">
                <text class="budget-metric-label">总预算</text>
                <text class="budget-metric-value">¥{{budget}}</text>
              </view>
              <view class="budget-metric-divider">
              </view>
              <view class="budget-metric-item is-right">
                <text class="budget-metric-label">已支出</text>
                <text class="budget-metric-value expense">¥{{monthExpense}}</text>
              </view>
            </view>
          </view>
          <view class="twin-capsules fade-up">
            <view class="capsule-card card" bindtap="goRecords">
              <view class="capsule-icon expense">
                <tl-icon name="arrow-right-up-line" size="32" colorKey="primary">
                </tl-icon>
              </view>
              <view class="capsule-data">
                <text class="capsule-label">本月支出</text>
                <text class="capsule-amount expense">¥{{monthExpenseCompact}}</text>
              </view>
            </view>
            <view class="capsule-card card" bindtap="goRecords">
              <view class="capsule-icon income">
                <tl-icon name="arrow-left-down-line" size="32" colorKey="income">
                </tl-icon>
              </view>
              <view class="capsule-data">
                <text class="capsule-label">本月收入</text>
                <text class="capsule-amount income">¥{{monthIncomeCompact}}</text>
              </view>
            </view>
          </view>
          <view wx:if="{{!showBudget || !budgetEnabled}}" class="summary-card card fade-up">
            <view class="summary-head">
              <view class="summary-title">本月概览</view>
              <view wx:if="{{canManageBudget}}" class="summary-action" bindtap="goBudgetSettings">设置预算</view>
            </view>
            <view class="overview-grid">
              <view class="overview-item">
                <view class="overview-label">收入</view>
                <view class="overview-value income">¥{{monthIncomeCompact}}</view>
              </view>
              <view class="overview-item">
                <view class="overview-label">支出</view>
                <view class="overview-value expense">¥{{monthExpenseCompact}}</view>
              </view>
              <view class="overview-item">
                <view class="overview-label">结余</view>
                <view class="overview-value">¥{{balanceCompact}}</view>
              </view>
            </view>
          </view>
          <view class="records-card card fade-up">
            <view class="section-head">
              <view class="section-title">最近记录</view>
              <view class="section-link" bindtap="goRecords">全部</view>
            </view>
            <view class="record-item" wx:for="{{recentRecords}}" wx:key="id" data-id="{{item.id}}" bindtap="goRecordDetail">
              <view class="category-dot {{item.chipClass || item.type}}">
                <tl-icon name="{{item.categoryIcon}}" size="34" color="{{item.typeIconColor}}">
                </tl-icon>
              </view>
              <view class="record-main">
                <view class="record-line">
                  <view class="record-title-row">
                    <text class="record-title">{{item.categoryText}}</text>
                    <text class="record-member-pill">{{item.memberName}}</text>
                  </view>
                  <view class="record-amount {{item.type}}">{{item.type === 'income' ? '+' : '-'}}¥{{item.amountText}}</view>
                </view>
                <view class="record-line record-subline">
                  <view class="record-meta">{{item.selectedTimeText}}</view>
                  <view wx:if="{{item.hasNote}}" class="record-note">{{item.noteText}}</view>
                </view>
              </view>
            </view>
            <view class="record-limit-tip">—仅展示账本最近10笔—</view>
          </view>
        </block>
      </block>
    </view>
  </scroll-view>
  <tl-ledger-switcher id="ledger-switcher" visible="{{isLedgerSwitcherVisible}}" ledgers="{{ledgers}}" selected-id="{{ledgerId}}" selected-text="当前使用" subtitle="点击账本即可切换" loading="{{isLoadingLedgers}}" error="{{ledgerLoadError}}" busy="{{isSwitchingLedger}}" show-actions="{{true}}" bind:select="chooseLedger" bind:close="closeLedgerSwitcher" bind:retry="switchLedger" bind:manage="goLedgerSettings" bind:create="goCreateLedger">
  </tl-ledger-switcher>
</view>
