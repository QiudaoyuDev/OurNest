<view class="page plain-page category-page">
  <tl-navbar title="{{ledgerName}}" showBack="{{true}}">
  </tl-navbar>
  <tl-container safe-area="{{false}}">
    <scroll-view class="page-scroll" scroll-y="{{true}}" enhanced="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
      <view class="page-content">
        <view class="type-switch fade-up">
          <view class="type-item {{type === 'expense' ? 'active expense' : ''}}" data-type="expense" bindtap="switchType">
            <tl-icon name="price-tag-3-line" size="30" colorKey="{{type === 'expense' ? 'white' : 'primary'}}">
            </tl-icon>
            <text>支出</text>
          </view>
          <view class="type-item {{type === 'income' ? 'active income' : ''}}" data-type="income" bindtap="switchType">
            <tl-icon name="funds-line" size="30" colorKey="{{type === 'income' ? 'white' : 'income'}}">
            </tl-icon>
            <text>收入</text>
          </view>
        </view>
        <view class="category-grid">
          <view wx:for="{{categories}}" wx:key="id" class="category-choice" data-id="{{item.id}}" bindtap="chooseCategory">
            <view class="category-choice-icon {{item.chipClass}}">
              <tl-icon name="{{item.icon}}" size="44" color="{{item.iconColor}}" />
            </view>
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </tl-container>
</view>
