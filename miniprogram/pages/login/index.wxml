<view class="login-page">
  <scroll-view class="login-scroll" scroll-y="{{true}}" enhanced="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
    <view class="login-content">
      <image class="login-logo soft-pop" src="/images/brand/our-nest-logo-256-transparent.png" mode="aspectFit">
      </image>
      <view class="login-title fade-up">顺手记一笔</view>
      <view class="login-subtitle fade-up">记好每一笔，生活更有数。</view>
      <tl-button class="login-button" block="{{true}}" loading="{{loggingIn}}" loading-text="登录中..." bind:tap="login">微信快捷登录</tl-button>
    </view>
  </scroll-view>
</view>
<tl-feedback-host>
</tl-feedback-host>
