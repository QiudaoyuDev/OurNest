<view class="page tab-shell-page">
  <tl-navbar
    title="{{navbarTitle}}"
    ledger-name="{{currentLedgerName}}"
    show-ledger="{{showNavbarLedger}}"
    bind:switchledger="onNavbarSwitchLedger"
  >
  </tl-navbar>
  <tl-container safe-area="{{false}}">
    <tl-tab-home
      wx:if="{{visitedTabs.index}}"
      id="tab-home"
      class="{{activeTab === 'index' ? '' : 'tab-pane-hidden'}}"
      bind:switchtab="switchTab"
    >
    </tl-tab-home>
    <tl-tab-records
      wx:if="{{visitedTabs.records}}"
      id="tab-records"
      class="{{activeTab === 'records' ? '' : 'tab-pane-hidden'}}"
      initial-month="{{recordsMonth}}"
    >
    </tl-tab-records>
    <tl-tab-analysis
      wx:if="{{visitedTabs.analysis}}"
      id="tab-analysis"
      class="{{activeTab === 'analysis' ? '' : 'tab-pane-hidden'}}"
      active="{{activeTab === 'analysis'}}"
      foreground="{{foreground}}"
    >
    </tl-tab-analysis>
    <tl-tab-profile
      wx:if="{{visitedTabs.profile}}"
      id="tab-profile"
      class="{{activeTab === 'profile' ? '' : 'tab-pane-hidden'}}"
    >
    </tl-tab-profile>
  </tl-container>
  <tl-tabbar active="{{activeTab}}" record-disabled-reason="{{recordDisabledReason}}" bind:change="switchTab">
  </tl-tabbar>
</view>
