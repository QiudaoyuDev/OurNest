.comparison-controls,
.comparison-list {
  padding: 28rpx;
  margin-bottom: 22rpx;
}
.comparison-title,
.comparison-heading {
  color: var(--tl-color-text);
  font-weight: var(--tl-font-weight-bold);
}
.comparison-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.comparison-period,
.comparison-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--tl-color-border-warm);
}
.comparison-period,
.comparison-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}
.comparison-note {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  line-height: 1.6;
}
.comparison-buttons .comparison-button {
  width: calc(50% - 6rpx);
  flex: 0 0 calc(50% - 6rpx);
}

.chart-note {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  line-height: 1.6;
}
.trend-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 10rpx 0;
}
.trend-label {
  width: 110rpx;
  flex: 0 0 110rpx;
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-caption);
}
.trend-bars {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}
.trend-track {
  height: 10rpx;
  background: var(--tl-color-surface-warm);
}
.trend-bar {
  height: 100%;
}
.trend-bar.income {
  background: var(--tl-color-income);
}
.trend-bar.expense {
  background: var(--tl-color-primary);
}
.trend-bar.balance {
  background: var(--tl-color-text-tertiary);
}
