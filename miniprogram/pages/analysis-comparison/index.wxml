<view class="page plain-page">
  <tl-navbar title="多期对比" showBack="{{true}}">
  </tl-navbar>
  <tl-container>
    <scroll-view class="page-scroll" scroll-y="{{true}}">
      <view class="page-content">
        <view class="comparison-controls card">
          <view class="comparison-title">{{ledgerName}} · 时间范围</view>
          <view class="comparison-buttons">
            <tl-button class="comparison-button" variant="secondary" size="small" data-quick="6m" bind:tap="setQuick">近6个月</tl-button>
            <tl-button class="comparison-button" variant="secondary" size="small" data-quick="12m" bind:tap="setQuick">近12个月</tl-button>
            <tl-button class="comparison-button" variant="secondary" size="small" data-quick="3y" bind:tap="setQuick">近3年</tl-button>
            <tl-button class="comparison-button" variant="secondary" size="small" data-quick="5y" bind:tap="setQuick">近5年</tl-button>
          </view>
          <view class="comparison-buttons">
            <tl-button class="comparison-button" variant="secondary" size="small" data-unit="month" bind:tap="changeUnit">自选月份</tl-button>
            <tl-button class="comparison-button" variant="secondary" size="small" data-unit="year" bind:tap="changeUnit">自选年份</tl-button>
          </view>
          <view wx:if="{{quick === 'manual'}}">
            <view wx:for="{{selected}}" class="comparison-period">
              <picker mode="date" fields="{{unit}}" value="{{unit === 'year' ? item + '-01-01' : item + '-01'}}" data-index="{{index}}" bindchange="changePeriod">
                <view>{{index === 0 ? '基准期' : '对比期'}}：{{item}}</view>
              </picker>
              <tl-button wx:if="{{selected.length > 2}}" variant="text" size="small" data-index="{{index}}" bind:tap="removePeriod">移除</tl-button>
            </view>
            <view class="comparison-buttons">
              <tl-button wx:if="{{selected.length < 5}}" class="comparison-button" variant="secondary" size="small" bind:tap="addPeriod">添加周期</tl-button>
              <tl-button class="comparison-button" size="small" loading="{{loading}}" bind:tap="load">开始对比</tl-button>
            </view>
          </view>
        </view>
        <tl-skeleton wx:if="{{loading}}" variant="list">
        </tl-skeleton>
        <block wx:elif="{{error}}">
          <tl-empty-state variant="error" title="对比暂不可用" description="{{error}}">
          </tl-empty-state>
        </block>
        <block wx:else>
          <view class="comparison-controls card">
            <view class="comparison-title">比较项目</view>
            <picker wx:if="{{ledgerType === 'shared'}}" mode="selector" range="{{families}}" range-key="label" value="{{familyIndex}}" bindchange="changeFamily">
              <view class="comparison-period">{{families[familyIndex].label}} ▾</view>
            </picker>
            <picker mode="selector" range="{{categories}}" range-key="label" value="{{categoryIndex}}" bindchange="changeCategory">
              <view class="comparison-period">{{categories[categoryIndex].label}} ▾</view>
            </picker>
            <view class="comparison-note">首个周期为基准；未结束周期按截至当天的记录统计。公共和多人消费按记录人展示。</view>
          </view>
          <view wx:if="{{rows.length}}" class="comparison-controls card">
            <view class="comparison-title">收支趋势</view>
            <view class="comparison-chart">
              <view class="chart-note">条形长度表示金额的绝对值，具体正负见明细。</view>
              <view wx:for="{{rows}}" wx:key="key" class="trend-row" data-index="{{index}}" bindtap="openPeriod">
                <text class="trend-label">{{item.key}}</text>
                <view class="trend-bars">
                  <view wx:if="{{categoryIndex !== 0 || familyIndex !== 0}}" class="trend-track">
                    <view class="trend-bar expense" style="width: {{item.amountWidth}}%">
                    </view>
                  </view>
                  <block wx:else>
                    <view class="trend-track">
                      <view class="trend-bar income" style="width: {{item.incomeWidth}}%">
                      </view>
                    </view>
                    <view class="trend-track">
                      <view class="trend-bar expense" style="width: {{item.expenseWidth}}%">
                      </view>
                    </view>
                    <view class="trend-track">
                      <view class="trend-bar balance" style="width: {{item.balanceWidth}}%">
                      </view>
                    </view>
                  </block>
                </view>
              </view>
              <view wx:if="{{categoryIndex === 0 && familyIndex === 0}}" class="chart-note">收入 / 支出 / 结余</view>
            </view>
          </view>
          <view wx:if="{{rows.length}}" class="comparison-list card">
            <view wx:for="{{rows}}" wx:key="key" class="comparison-row" data-index="{{index}}" bindtap="openPeriod">
              <view class="comparison-heading">
                <text>{{item.key}}{{item.partial ? ' · 未结束' : ''}}</text>
                <text wx:if="{{categoryIndex !== 0 || familyIndex !== 0}}">¥{{item.amountText}}</text>
              </view>
              <view wx:if="{{categoryIndex === 0 && familyIndex === 0}}">收入 ¥{{item.incomeText}} · 支出 ¥{{item.expenseText}} · 结余 ¥{{item.balanceText}}</view>
              <view wx:if="{{categoryIndex === 0 && familyIndex === 0}}" class="comparison-note">收入{{item.incomeChange}} · 支出{{item.expenseChange}} · 结余{{item.balanceChange}}</view>
              <view wx:else class="comparison-note">{{item.changeText}}</view>
              <view class="comparison-note">{{item.start}} 起至 {{item.end}} 前</view>
            </view>
          </view>
          <tl-empty-state wx:else title="暂无可比较数据" description="选择时间范围后查看">
          </tl-empty-state>
        </block>
      </view>
    </scroll-view>
  </tl-container>
</view>
