<view class="page plain-page record-detail-page">
  <tl-navbar title="记录明细" showBack="{{true}}">
  </tl-navbar>
  <tl-container>
    <scroll-view class="page-scroll" scroll-y="{{true}}" enhanced="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
      <view class="page-content">
        <tl-skeleton wx:if="{{loading}}" variant="detail">
        </tl-skeleton>
        <tl-empty-state wx:elif="{{isError}}" variant="error" title="记录加载失败" description="请检查网络后重试">
          <tl-button variant="secondary" size="small" bind:tap="reload">重新加载</tl-button>
        </tl-empty-state>
        <block wx:else>
          <view class="detail-hero">
            <view class="hero-caption hero-category">
              <view class="hero-category-icon {{record.categoryChipClass}}">
                <tl-icon name="{{record.categoryDisplayIcon}}" size="32" color="{{record.categoryIconColor}}">
                </tl-icon>
              </view>
              <text class="hero-category-label">{{record.typeText}} / {{record.parentCategoryText ? record.parentCategoryText + ' / ' : ''}}{{record.categoryText}}</text>
            </view>
            <view class="amount {{record.type}}">{{record.sign}}¥{{record.amountText}}</view>
            <view class="hero-caption">{{record.selectedTimeText}}</view>
          </view>
          <view class="detail-section">
            <view class="section-title">交易信息</view>
            <view class="detail-row">
              <text class="detail-label">账本</text>
              <text class="detail-value">{{record.ledgerName}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">账本类型</text>
              <text class="detail-value">{{record.ledgerTypeText}}</text>
            </view>
            <view wx:if="{{record.sourceText}}" class="detail-row">
              <text class="detail-label">来源</text>
              <text class="detail-value">{{record.sourceText}}</text>
            </view>
            <view wx:if="{{record.sourceTransactionId}}" class="detail-row">
              <text class="detail-label">来源交易号</text>
              <text class="detail-value">{{record.sourceTransactionId}}</text>
            </view>
            <view wx:if="{{record.importBatchId}}" class="detail-row">
              <text class="detail-label">导入批次</text>
              <text class="detail-value">{{record.importBatchId}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">账户</text>
              <text class="detail-value">{{record.accountText}}</text>
            </view>
          </view>
          <view class="detail-section">
            <view class="section-title">家庭记录</view>
            <view class="detail-row">
              <text class="detail-label">记录人</text>
              <view class="member-info">
                <image class="member-avatar" src="{{record.memberAvatar}}" mode="aspectFill">
                </image>
                <text class="member-name">{{record.memberName}}</text>
              </view>
            </view>
            <view wx:if="{{record.ledgerTypeText === '共享账本' && record.type === 'income'}}" class="detail-row">
              <text class="detail-label">收入归属</text>
              <text class="detail-value">{{record.incomeRecipientText}}</text>
            </view>
            <view wx:if="{{record.ledgerTypeText === '共享账本' && record.type === 'expense'}}" class="detail-row">
              <text class="detail-label">付款人</text>
              <text class="detail-value">{{record.familyDisplay.payerName}}</text>
            </view>
            <view wx:if="{{record.ledgerTypeText === '共享账本' && record.type === 'expense'}}" class="detail-row">
              <text class="detail-label">消费归属</text>
              <text class="detail-value">{{record.familyDisplay.consumerName}}</text>
            </view>
            <view class="note-block">
              <view class="detail-label">备注</view>
              <view class="note-text">{{record.noteText}}</view>
              <view class="tag-list" wx:if="{{record.hasTags}}">
                <view class="tag-chip" wx:for="{{record.tags}}" wx:key="*this">#{{item}}</view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </scroll-view>
  </tl-container>
</view>
