.record-detail-page {
  background: var(--tl-color-surface);
}

.detail-hero {
  padding: 56rpx 0 48rpx;
  border-bottom: var(--tl-border-width) solid var(--tl-color-border-subtle);
}

.hero-caption {
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.hero-category {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.hero-category-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--tl-radius-xs);
}

.hero-category-label {
  min-width: 0;
  overflow-wrap: anywhere;
}

.amount {
  margin: 16rpx 0 32rpx;
  font-size: var(--tl-font-data-xl);
  line-height: 1.2;
  font-weight: var(--tl-font-weight-bold);
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}

.amount.expense {
  color: var(--tl-color-primary);
}

.amount.income {
  color: var(--tl-color-income);
}

.detail-section {
  padding-top: 16rpx;
}

.section-title {
  padding: 24rpx 0 0;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.detail-row {
  min-height: 80rpx;
  padding: 24rpx 0;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 32rpx;
  border-bottom: var(--tl-border-width) solid var(--tl-color-border-subtle);
}

.detail-label {
  flex: 0 0 auto;
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  line-height: 1.6;
}

.detail-value,
.member-name {
  min-width: 0;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body-sm);
  line-height: 1.6;
  text-align: right;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.member-info {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.member-avatar {
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 40rpx;
  border-radius: 50%;
  background: var(--tl-color-primary-soft);
}

.note-block {
  padding: 24rpx 0;
}

.note-text {
  margin-top: 16rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
  line-height: 1.6;
  overflow-wrap: anywhere;
  word-break: break-all;
  white-space: pre-wrap;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag-chip {
  max-width: 100%;
  padding: 4rpx 16rpx;
  border-radius: var(--tl-radius-sm);
  color: var(--tl-color-primary-ink);
  background: var(--tl-color-primary-soft);
  font-size: var(--tl-font-body-sm);
  overflow-wrap: anywhere;
  word-break: break-all;
}
