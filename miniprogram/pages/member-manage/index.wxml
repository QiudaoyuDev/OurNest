<view class="page plain-page member-manage-page">
  <tl-navbar title="成员管理" showBack="{{true}}">
  </tl-navbar>
  <tl-container>
    <scroll-view class="page-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="page-content">
        <view class="page-head fade-up">
          <view class="ledger-name">{{ledgerName}}</view>
          <view class="ledger-tip">当前账本的所有成员与访客</view>
        </view>
        <tl-skeleton wx:if="{{loading}}" variant="list">
        </tl-skeleton>
        <tl-empty-state wx:elif="{{error}}" variant="error" title="加载失败" description="成员信息暂时无法加载">
          <tl-button variant="secondary" size="small" bind:tap="loadMembers">重新加载</tl-button>
        </tl-empty-state>
        <block wx:else>
          <view class="member-card card fade-up">
            <view wx:for="{{members}}" wx:key="openid" class="member-row">
              <image class="member-avatar" src="{{item.avatarUrl}}" mode="aspectFill">
              </image>
              <view class="member-info">
                <view class="member-name">{{item.nickName}}</view>
                <view class="member-role {{item.roleClass}}">{{item.roleText}}</view>
              </view>
              <view wx:if="{{canManage && !item.isOwner}}" class="member-remove" data-openid="{{item.openid}}" data-name="{{item.nickName}}" bindtap="removeMember">移除</view>
              <view wx:if="{{canManage && !item.isOwner && ledger.type === 'shared'}}" class="member-remove" data-openid="{{item.openid}}" data-name="{{item.nickName}}" data-role="{{item.role}}" bindtap="changeRole">调整权限</view>
              <view wx:if="{{canManage && item.role === 'member' && ledger.type === 'shared'}}" class="member-remove" data-openid="{{item.openid}}" data-name="{{item.nickName}}" bindtap="transferOwner">转移</view>
            </view>
          </view>
          <tl-button wx:if="{{canManage}}" class="page-submit" block="{{true}}" bind:tap="inviteLedger">
            <tl-icon name="user-add-line" size="34" colorKey="white">
            </tl-icon>
            <text>邀请成员</text>
          </tl-button>
          <view wx:else class="readonly-tip">仅账本拥有者可以邀请或移除成员</view>
          <tl-button wx:if="{{!canManage}}" variant="secondary" block="{{true}}" bind:tap="leaveLedger">退出账本</tl-button>
          <view wx:if="{{ownerTransfer}}" class="card">
            <view>账本所有权转移待确认</view>
            <tl-button wx:if="{{!canManage}}" block="{{true}}" data-accept="{{true}}" bind:tap="respondTransfer">确认接收</tl-button>
            <tl-button variant="secondary" block="{{true}}" data-accept="{{false}}" bind:tap="respondTransfer">{{canManage ? '取消转移' : '拒绝接收'}}</tl-button>
          </view>
          <view wx:if="{{canManage && invites.length}}" class="card">
            <view>有效邀请</view>
            <view wx:for="{{invites}}" wx:key="id" class="member-row">
              <view class="member-info">{{item.mode === 'member' ? '成员' : '访客'}} · 创建于 {{item.createdText}} · {{item.expiresText}} 到期</view>
              <view class="member-remove" data-id="{{item.id}}" bindtap="revokeInvite">撤销</view>
            </view>
          </view>
        </block>
      </view>
    </scroll-view>
    <tl-bottom-sheet visible="{{shareSheetVisible}}" bind:close="closeShareSheet">
      <view class="share-sheet">
        <view class="sheet-title">选择邀请方式</view>
        <view wx:for="{{shareOptions}}" wx:key="mode" class="share-option {{shareMode === item.mode ? 'is-selected' : ''}}" data-mode="{{item.mode}}" bindtap="selectShareMode" role="radio" aria-checked="{{shareMode === item.mode}}" aria-label="{{item.title}}，{{item.desc}}">
          <tl-icon name="{{item.icon}}" size="34" colorKey="primaryDark">
          </tl-icon>
          <view class="share-option-content">
            <view>{{item.title}}</view>
            <text>{{item.desc}}</text>
          </view>
          <view class="share-option-indicator {{shareMode === item.mode ? 'is-selected' : ''}}">
            <tl-icon wx:if="{{shareMode === item.mode}}" name="check-line" size="24" colorKey="white">
            </tl-icon>
          </view>
        </view>
        <tl-button wx:if="{{!inviteCode}}" block="{{true}}" loading="{{generating}}" bind:tap="generateInvite">生成邀请码</tl-button>
        <view wx:if="{{inviteCode}}" class="invite-code-display">{{displayCode}}</view>
        <view wx:if="{{inviteCode}}" class="invite-code-hint">有效期至 {{inviteExpiresAt}}，仅可使用一次，请只发送给信任的人。</view>
        <view wx:if="{{inviteCode}}" class="invite-actions">
          <tl-button block="{{true}}" bind:tap="copyInviteCode">复制邀请码</tl-button>
          <tl-button variant="secondary" block="{{true}}" open-type="share">发送分享卡片</tl-button>
        </view>
      </view>
    </tl-bottom-sheet>
  </tl-container>
</view>
