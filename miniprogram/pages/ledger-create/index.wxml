<view class="page plain-page ledger-create-page">
  <tl-navbar title="创建账本" showBack="{{true}}">
  </tl-navbar>
  <tl-container>
    <scroll-view class="page-scroll" scroll-y="{{true}}" enhanced="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
      <view class="page-content ledger-create-content">
        <view wx:if="{{stage === 'type'}}" class="scene">
          <view class="logo-mark">
            <image class="brand-logo" src="/images/brand/our-nest-logo-256-transparent.png" mode="aspectFit">
            </image>
          </view>
          <view class="scene-title">新建一个账本</view>
          <view class="scene-subtitle">选择适合你的记录方式</view>
        </view>
        <view wx:if="{{stage === 'type'}}" class="type-stage fade-up">
          <view class="type-grid">
            <view class="type-option" wx:for="{{ledgerTypes}}" wx:key="key" data-type="{{item.key}}" bindtap="selectType" style="--accent: {{item.accent}}; --soft: {{item.soft}}; --tint: {{item.tint}};">
              <view class="type-icon">
                <tl-icon name="{{item.icon}}" size="38" color="{{item.accent}}">
                </tl-icon>
              </view>
              <view class="type-main">
                <view class="type-title">{{item.title}}</view>
                <view class="type-subtitle">{{item.subtitle}}</view>
              </view>
            </view>
          </view>
          <view class="type-option join-option" bindtap="joinByCode">
            <view class="type-icon">
              <tl-icon name="coupon-3-line" size="38" colorKey="primary">
              </tl-icon>
            </view>
            <view class="type-main">
              <view class="type-title">输入邀请码加入</view>
              <view class="type-subtitle">加入已有账本</view>
            </view>
          </view>
        </view>
        <view wx:else class="detail-stage fade-up">
          <view class="step-line">
            <view class="selected-pill">{{selectedType === 'shared' ? '共享账本' : '个人账本'}}</view>
            <tl-button class="back-type" variant="secondary" size="small" bind:tap="backToType">更换类型</tl-button>
          </view>
          <view class="form-panel">
            <view class="field-block">
              <view class="field-label">
                账本名称
                <text class="required-star">*</text>
              </view>
              <input class="ledger-input" value="{{name}}" placeholder="1-8个字符，例如：日常" bindinput="onNameInput" />
            </view>
            <view class="field-block">
              <view class="field-label">
                账本备注
                <text class="optional-tip">（选填）</text>
              </view>
              <textarea class="ledger-textarea" value="{{remark}}" maxlength="80" placeholder="写一句它的用途，例如：家庭日常开销" bindinput="onRemarkInput">
              </textarea>
            </view>
            <view class="field-block">
              <view class="budget-switch-row">
                <view>
                  <view class="field-label">月预算</view>
                  <view class="budget-switch-tip">开启后可查看每月消费进度</view>
                </view>
                <view class="budget-toggle {{budgetEnabled ? 'is-on' : ''}}" bindtap="toggleBudget">
                  <view class="budget-toggle-knob">
                  </view>
                  <text>{{budgetEnabled ? '已开启' : '已关闭'}}</text>
                </view>
              </view>
              <view wx:if="{{budgetEnabled}}" class="budget-input-wrap">
                <view class="field-label">
                  月预算金额
                  <text class="required-star">*</text>
                </view>
                <view class="budget-input-row">
                  <text>¥</text>
                  <input class="budget-input" type="digit" value="{{monthlyBudget}}" placeholder="1 - 999999，最多两位小数" bindinput="onBudgetInput" />
                </view>
              </view>
            </view>
            <view class="field-block">
              <view class="budget-switch-row">
                <view>
                  <view class="field-label">快捷金额</view>
                  <view class="budget-switch-tip">开启后可一键填入金额，创建后可在「我的 - 快捷金额」配置</view>
                </view>
                <view class="budget-toggle {{quickAmountsEnabled ? 'is-on' : ''}}" bindtap="toggleQuickAmounts">
                  <view class="budget-toggle-knob">
                  </view>
                  <text>{{quickAmountsEnabled ? '已开启' : '已关闭'}}</text>
                </view>
              </view>
            </view>
            <tl-button class="page-submit" block="{{true}}" loading="{{saving}}" loading-text="创建中..." bind:tap="createLedger">创建账本</tl-button>
          </view>
        </view>
      </view>
    </scroll-view>
    <tl-bottom-sheet visible="{{resultVisible}}" close-on-mask="{{false}}">
      <view class="result-sheet">
        <view class="result-title">创建成功</view>
        <view class="result-summary">
          <view class="summary-item">
            <text class="summary-label">账本名称</text>
            <text class="summary-value">{{createdLedger.name}}</text>
          </view>
          <view class="summary-item">
            <text class="summary-label">月预算</text>
            <text class="summary-value">{{createdLedger.budgetEnabled ? '已开启' : '未开启'}}</text>
          </view>
          <view wx:if="{{createdLedger.quickAmountsEnabled}}" class="quick-amount-guide">快捷金额已开启，可在「我的 - 快捷金额」修改常用金额</view>
        </view>
        <view class="sheet-actions">
          <tl-button wx:if="{{createdLedger.type === 'shared'}}" variant="secondary" block="{{true}}" bind:tap="inviteMembers">邀请成员</tl-button>
          <tl-button block="{{true}}" bind:tap="goRecord">记一笔</tl-button>
          <tl-button variant="secondary" block="{{true}}" bind:tap="closeResult">关闭</tl-button>
        </view>
      </view>
    </tl-bottom-sheet>
  </tl-container>
</view>
