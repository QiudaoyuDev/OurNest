<view class="page plain-page payment-account-page">
  <tl-navbar title="支付账户" showBack="{{true}}">
  </tl-navbar>
  <tl-container safe-area="{{false}}">
    <scroll-view class="page-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="page-content">
        <view class="account-card card fade-up">
          <view class="account-header">
            <view>
              <view class="account-title">{{ledgerName}}</view>
              <view class="account-subtitle">记一笔时可选择以下支付账户</view>
            </view>
            <tl-icon name="bank-card-line" size="42" colorKey="primary">
            </tl-icon>
          </view>
          <view class="account-list">
            <view wx:for="{{accounts}}" wx:key="*this" class="account-row">
              <view class="account-icon">
                <tl-icon name="wallet-3-line" size="32" colorKey="primary">
                </tl-icon>
              </view>
              <text class="account-name">{{item}}</text>
              <text wx:if="{{!readonly}}" class="delete-text" data-index="{{index}}" bindtap="openDeleteDialog">删除</text>
            </view>
          </view>
        </view>
        <view wx:if="{{readonly}}" class="readonly-tip">访客不能管理支付账户</view>
      </view>
    </scroll-view>
  </tl-container>
  <tl-page-actions wx:if="{{!readonly}}">
    <tl-button block="{{true}}" loading="{{saving}}" loading-text="保存中..." bind:tap="openAddDialog">
      <tl-icon name="add-line" size="32" colorKey="white">
      </tl-icon>
      <text>新增账户</text>
    </tl-button>
  </tl-page-actions>
  <!-- 新增账户 Dialog -->
  <tl-dialog visible="{{addDialogVisible}}" bind:close="closeAddDialog">
    <view class="custom-dialog-panel">
      <view class="dialog-icon-wrap">
        <tl-icon name="bank-card-line" size="48" color="#f0442f">
        </tl-icon>
      </view>
      <view class="dialog-title">新增支付账户</view>
      <view class="dialog-desc">记一笔时可按此账户归类（如信用卡、微信等）</view>
      <view class="dialog-input-box">
        <input
          class="dialog-input-field"
          value="{{accountDraft}}"
          placeholder="例如：招商银行信用卡"
          placeholder-class="dialog-input-placeholder"
          maxlength="12"
          confirm-type="done"
          bindinput="onDraftInput"
          bindconfirm="confirmAddAccount"
          focus="{{addDialogVisible}}"
          adjust-position="{{true}}"
          cursor-spacing="140"
        />
        <view wx:if="{{accountDraft.length > 0}}" class="dialog-input-clear" bindtap="clearDraft">
          <tl-icon name="close-circle-fill" size="32" colorKey="muted">
          </tl-icon>
        </view>
      </view>
      <view class="dialog-counter">{{accountDraft.length}}/12</view>
      <view class="dialog-actions">
        <tl-button variant="secondary" block="{{true}}" bind:tap="closeAddDialog">取消</tl-button>
        <tl-button block="{{true}}" loading="{{saving}}" bind:tap="confirmAddAccount">添加</tl-button>
      </view>
    </view>
  </tl-dialog>
  <!-- 删除账户确认 Dialog -->
  <tl-dialog visible="{{deleteDialogVisible}}" bind:close="closeDeleteDialog">
    <view class="custom-dialog-panel">
      <view class="dialog-icon-wrap danger-wrap">
        <tl-icon name="delete-bin-line" size="48" color="#f0442f">
        </tl-icon>
      </view>
      <view class="dialog-title">删除支付账户</view>
      <view class="dialog-desc">确认删除“{{deletingAccount}}”吗？删除后，已有记账记录仍会保留该账户名称。</view>
      <view class="dialog-actions">
        <tl-button variant="secondary" block="{{true}}" bind:tap="closeDeleteDialog">取消</tl-button>
        <tl-button block="{{true}}" loading="{{saving}}" bind:tap="confirmDeleteAccount">确认删除</tl-button>
      </view>
    </view>
  </tl-dialog>
</view>
