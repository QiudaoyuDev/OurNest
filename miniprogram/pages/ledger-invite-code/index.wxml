<view class="page plain-page invite-page">
  <tl-navbar title="输入邀请码" showBack="{{true}}">
  </tl-navbar>
  <tl-container>
    <scroll-view class="page-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" enable-flex="{{true}}">
      <view class="page-content invite-content">
        <view wx:if="{{status === 'input'}}" class="invite-card card">
          <view class="invite-title">加入已有账本</view>
          <view class="invite-tip">输入账本拥有者发给你的邀请码，确认信息后即可加入。</view>
          <view class="invite-field">
            <view class="invite-label">邀请码</view>
            <input class="invite-input" value="{{code}}" maxlength="32" placeholder="请输入 8 位邀请码" placeholder-class="invite-placeholder" disabled="{{busy}}" confirm-type="done" bindinput="onInput" bindconfirm="previewInvite" />
            <view class="invite-field-tip">支持粘贴邀请码，字母不区分大小写。</view>
          </view>
          <tl-button block="{{true}}" loading="{{busy}}" loading-text="正在查看" bind:tap="previewInvite">查看邀请</tl-button>
        </view>
        <view wx:elif="{{status === 'preview'}}" class="invite-card card">
          <view class="invite-title">邀请你加入账本</view>
          <view class="invite-tip">请确认以下账本和权限信息。</view>
          <view class="invite-details">
            <view class="invite-row">
              <text class="invite-row-label">账本</text>
              <text class="invite-row-value">{{preview.ledgerName}}</text>
            </view>
            <view class="invite-row">
              <text class="invite-row-label">邀请人</text>
              <text class="invite-row-value">{{preview.ownerName}}</text>
            </view>
            <view class="invite-row">
              <text class="invite-row-label">权限</text>
              <text class="invite-row-value">{{preview.currentRole === 'owner' ? '拥有者' : preview.mode === 'member' ? '成员' : '只读访客'}}</text>
            </view>
          </view>
          <view class="invite-tip">{{preview.currentRole === 'owner' ? '你是这个账本的拥有者' : preview.mode === 'member' ? '可记账、查看账目，并编辑或删除自己录入的记录' : '可查看账本数据，不能记账或修改'}}</view>
          <view wx:if="{{preview.already}}" class="invite-tip">你已加入该账本，此操作不会改变现有角色；未使用的新邀请码不会被消耗。需要调整权限请联系拥有者。</view>
          <view class="invite-actions">
            <tl-button block="{{true}}" loading="{{busy}}" loading-text="正在加入" bind:tap="join">{{preview.already ? '查看账本' : '确认加入'}}</tl-button>
            <tl-button variant="secondary" block="{{true}}" disabled="{{busy}}" bind:tap="editCode">修改邀请码</tl-button>
          </view>
        </view>
        <view wx:else class="invite-card card">
          <view class="invite-title">{{already ? '你已加入该账本' : '加入成功'}}</view>
          <view class="invite-tip">{{preview.ledgerName}}</view>
          <view class="invite-actions">
            <tl-button block="{{true}}" loading="{{opening}}" loading-text="正在打开" bind:tap="openLedger">进入这个账本</tl-button>
            <tl-button variant="secondary" block="{{true}}" disabled="{{opening}}" bind:tap="goBack">稍后再说</tl-button>
          </view>
        </view>
      </view>
    </scroll-view>
  </tl-container>
</view>
