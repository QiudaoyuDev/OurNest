<view class="page plain-page category-manage-page">
  <tl-navbar title="{{ledgerName}}" showBack="{{true}}">
  </tl-navbar>
  <tl-container safe-area="{{false}}">
    <scroll-view class="page-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="page-content">
        <!-- 支出/收入 分类切换胶囊 -->
        <view class="category-tabs">
          <view class="tab-indicator {{pageIndex === 1 ? 'to-income' : ''}}">
          </view>
          <view class="tab {{pageIndex === 0 ? 'active' : ''}}" data-index="0" bindtap="changePage">支出分类</view>
          <view class="tab {{pageIndex === 1 ? 'active' : ''}}" data-index="1" bindtap="changePage">收入分类</view>
        </view>
        <!-- 温馨提示条 -->
        <view class="category-hint-bar">
          <tl-icon name="information-line" size="26" colorKey="muted">
          </tl-icon>
          <text>点击任意分类即可修改名称、更换图标或进行分类管理</text>
        </view>
        <!-- 分类网格 -->
        <view class="category-panel">
          <block wx:for="{{currentRows}}" wx:key="id" wx:for-item="row">
            <view class="parent-grid">
              <block wx:for="{{row.items}}" wx:key="_id" wx:for-item="item">
                <view class="category-item {{item.isProtected ? 'is-protected' : ''}} {{type==='income'?'income':''}}" data-item="{{item}}" bindtap="handleCategoryTap">
                  <view class="category-icon {{item.chipClass || (type==='income'?'income':'expense')}}">
                    <tl-icon name="{{item.icon}}" size="42" color="{{item.iconColor || (type==='income'?'#25a66a':'#f0442f')}}">
                    </tl-icon>
                  </view>
                  <view class="category-label-wrap">
                    <text class="category-name">{{item.name}}</text>
                    <text wx:if="{{item.isProtected}}" class="category-tag">内置</text>
                  </view>
                </view>
              </block>
            </view>
          </block>
        </view>
      </view>
    </scroll-view>
  </tl-container>
  <!-- 底部常驻固钉：新增分类 -->
  <tl-page-actions wx:if="{{canCreate}}">
    <tl-button block="{{true}}" bind:tap="openCreate">
      <tl-icon name="add-line" size="32" colorKey="white">
      </tl-icon>
      <text>新增{{type === 'income' ? '收入' : '支出'}}分类</text>
    </tl-button>
  </tl-page-actions>
  <!-- 分类编辑/新增 Bottom Sheet -->
  <tl-bottom-sheet visible="{{showEditor}}" bind:close="closeEditor">
    <view class="editor-sheet">
      <view class="sheet-header">
        <view class="sheet-title">{{editingItem ? '分类设置与管理' : ('新增' + (type==='income'?'收入':'支出') + '分类')}}</view>
        <view class="sheet-subtitle">{{editingItem ? (editingItem.isProtected ? '系统基础预设分类' : '自定义分类') : '为小家账本定制专属分类'}}</view>
      </view>
      <!-- 系统受保护分类提示 -->
      <view wx:if="{{editingItem && editingItem.isProtected}}" class="protected-notice-card">
        <view class="notice-icon-box">
          <tl-icon name="shield-check-line" size="44" color="#f0442f">
          </tl-icon>
        </view>
        <view class="notice-title">系统内置基础分类</view>
        <view class="notice-desc">“{{editingItem.name}}”是系统预设的基础归档分类，关联着账本的分类容错与记账汇总，不可编辑或删除，可随时用于记账。</view>
        <tl-button variant="secondary" block="{{true}}" bind:tap="closeEditor">我知道了</tl-button>
      </view>
      <!-- 普通成员只读提示（非 Owner 且为已有分类） -->
      <view wx:elif="{{editingItem && role !== 'owner'}}" class="readonly-notice-card">
        <view class="editor-icon-preview chosen">
          <tl-icon name="{{draftIcon}}" size="46" colorKey="{{type==='income'?'income':'primary'}}">
          </tl-icon>
        </view>
        <view class="notice-title">{{editingItem.name}}</view>
        <view class="notice-desc">协作成员可以查看该分类并用于记账，修改分类名称、更换图标或删除需由账本拥有者操作。</view>
        <tl-button variant="secondary" block="{{true}}" bind:tap="closeEditor">我知道了</tl-button>
      </view>
      <!-- 可编辑表单（新建分类，或 Owner 编辑非保护分类） -->
      <view wx:else class="editor-form">
        <view class="editor-icon-wrapper" bindtap="chooseIcon">
          <view class="editor-icon {{draftIcon ? 'chosen' : ''}}">
            <tl-icon wx:if="{{draftIcon}}" name="{{draftIcon}}" size="46" colorKey="{{type==='income'?'income':'primary'}}">
            </tl-icon>
            <text wx:else>+</text>
          </view>
          <view class="icon-picker-tip">
            <text class="icon-tip-main">{{draftIcon ? '点击更换图标' : '点击选择图标'}}</text>
            <tl-icon name="arrow-right-s-line" size="24" colorKey="muted">
            </tl-icon>
          </view>
        </view>
        <view class="editor-input-wrap">
          <view class="editor-input-label">分类名称</view>
          <view class="editor-input-box">
            <input class="name-input" value="{{draftName}}" placeholder="例如：咖啡、健身、宠物" maxlength="6" adjust-position="{{true}}" cursor-spacing="140" bindinput="bindNameInput"/>
            <view class="name-count">{{draftName.length}}/6</view>
          </view>
        </view>
        <view class="editor-actions">
          <tl-button block="{{true}}" loading="{{saving}}" loading-text="保存中..." bind:tap="saveEditor">{{editingItem ? '保存修改' : '确认添加'}}</tl-button>
          <tl-button wx:if="{{editingItem && role === 'owner'}}" variant="secondary" block="{{true}}" disabled="{{saving}}" bind:tap="openDeleteDialog">
            <text class="delete-btn-text">删除该分类</text>
          </tl-button>
        </view>
      </view>
    </view>
  </tl-bottom-sheet>
  <!-- 删除分类二次确认 Dialog -->
  <tl-dialog visible="{{deleteDialogVisible}}" bind:close="closeDeleteDialog">
    <view class="custom-dialog-panel">
      <view class="dialog-icon-wrap danger-wrap">
        <tl-icon name="delete-bin-line" size="48" color="#f0442f">
        </tl-icon>
      </view>
      <view class="dialog-title">删除分类</view>
      <view class="dialog-desc">确认删除“{{deletingItem.name}}”吗？\n删除后，已有记账记录将自动保留并转入“其他”分类，不会丢失历史账目。</view>
      <view class="dialog-actions">
        <tl-button variant="secondary" block="{{true}}" bind:tap="closeDeleteDialog">取消</tl-button>
        <tl-button block="{{true}}" loading="{{deleting}}" bind:tap="confirmDelete">确认删除</tl-button>
      </view>
    </view>
  </tl-dialog>
</view>
