.filtered-summary,
.filtered-list {
  padding: 28rpx;
}
.filtered-summary {
  color: var(--tl-color-text-secondary);
  line-height: 1.8;
}
.filtered-list {
  margin-top: 22rpx;
}
.filtered-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--tl-color-border-warm);
  color: var(--tl-color-text);
}
.filtered-meta {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}
