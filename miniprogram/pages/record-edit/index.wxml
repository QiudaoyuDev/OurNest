<view class="page plain-page edit-page">
  <tl-navbar title="{{isEditing ? typeLabel + '明细' : '记一笔'}}" showBack="{{true}}" intercept-back="{{!isEditing}}" bind:back="handleEntryBack">
  </tl-navbar>
  <tl-container safe-area="{{false}}">
    <scroll-view class="page-scroll" scroll-y="{{true}}" enhanced="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
      <view class="page-content">
        <tl-skeleton wx:if="{{recordLoading}}" variant="detail">
        </tl-skeleton>
        <tl-empty-state wx:elif="{{recordLoadError}}" variant="error" title="记录加载失败" description="请检查网络后重试">
          <tl-button variant="secondary" size="small" bind:tap="reloadRecord">重新加载</tl-button>
        </tl-empty-state>
        <block wx:elif="{{!readonly}}">
          <view wx:if="{{isEditing}}" class="selected-card card fade-up" bindtap="reselectCategory">
            <view class="selected-left">
              <view class="type-badge {{type}}">
                <tl-icon name="{{typeIcon}}" size="24" colorKey="{{type === 'income' ? 'income' : 'primary'}}">
                </tl-icon>
                <text>{{typeLabel}}</text>
              </view>
              <view class="selected-icon {{selectedChipClass || type}}">
                <tl-icon name="{{categoryIcon}}" size="34" color="{{selectedIconColor || (type === 'income' ? '#25a66a' : '#f0442f')}}">
                </tl-icon>
              </view>
              <view class="selected-text">
                <view class="selected-name">{{categoryLabel}}</view>
              </view>
            </view>
            <view class="change-link">重选</view>
          </view>
          <view wx:if="{{!isEditing}}" class="entry-dashboard card fade-up">
            <view class="type-switch">
              <tl-button variant="{{type === 'expense' ? 'primary' : 'secondary'}}" block="{{true}}" data-type="expense" bind:tap="switchType">支出</tl-button>
              <tl-button variant="{{type === 'income' ? 'primary' : 'secondary'}}" block="{{true}}" data-type="income" bind:tap="switchType">收入</tl-button>
            </view>
          </view>
          <view wx:if="{{!isEditing}}" class="category-section card fade-up">
            <view class="category-heading">
              <text class="category-heading-title">请选择分类</text>
            </view>
            <scroll-view class="category-tree-scroll {{categoryId ? 'category-tree-scroll--selected' : ''}}" scroll-y="{{true}}" show-scrollbar="{{false}}" enhanced="{{true}}">
              <tl-skeleton wx:if="{{categoryLoading}}" variant="list">
              </tl-skeleton>
              <tl-empty-state wx:elif="{{categoryError}}" variant="error" title="分类加载失败" description="请检查网络后重试">
                <tl-button variant="secondary" size="small" bind:tap="loadCategories">重新加载</tl-button>
              </tl-empty-state>
              <tl-empty-state wx:elif="{{!flatCategories.length}}" title="暂无分类" description="请到我的 → 分类管理添加分类">
              </tl-empty-state>
              <view wx:else class="category-grid">
                <view wx:for="{{flatCategories}}" wx:key="id" class="category-grid-item {{categoryId === item.id ? 'is-selected' : ''}}" data-category-id="{{item.id}}" bindtap="chooseCategory">
                  <view class="category-grid-icon {{item.chipClass}}">
                    <tl-icon name="{{item.icon}}" size="36" color="{{item.iconColor || '#f0442f'}}">
                    </tl-icon>
                  </view>
                  <text class="category-grid-name">{{item.name}}</text>
                  <text wx:if="{{item.parentHint}}" class="category-grid-parent">{{item.parentHint}}</text>
                </view>
              </view>
            </scroll-view>
          </view>
          <view wx:if="{{isEditing && (familyError || (familyEnabled && type === 'expense'))}}" class="family-card card">
            <view class="family-title">家庭归属</view>
            <block wx:if="{{familyLoading}}">
              <view class="family-note">正在同步家庭成员…</view>
            </block>
            <block wx:elif="{{familyError}}">
              <view class="family-note">成员信息加载失败，无法保存家庭归属。</view>
              <tl-button variant="secondary" size="small" bind:tap="retryFamilyContext">重新加载</tl-button>
            </block>
            <block wx:else>
              <view class="family-row">
                <text>付款人</text>
                <picker mode="selector" range="{{familyMembers}}" range-key="nickName" value="{{familyPayerIndex}}" bindchange="changeFamilyPayer">
                  <view>{{familyMembers[familyPayerIndex].nickName}} ▾</view>
                </picker>
              </view>
              <view class="family-row">
                <text>消费归属</text>
                <picker mode="selector" range="{{familyKinds}}" range-key="label" value="{{familyKindIndex}}" bindchange="changeFamilyKind">
                  <view>{{familyKinds[familyKindIndex].label}} ▾</view>
                </picker>
              </view>
              <view wx:if="{{familyKinds[familyKindIndex].value === 'personal'}}" class="family-row">
                <text>消费成员</text>
                <picker mode="selector" range="{{familyConsumers}}" range-key="nickName" value="{{familyConsumerIndex}}" bindchange="changeFamilyConsumer">
                  <view>{{familyConsumers[familyConsumerIndex].nickName}} ▾</view>
                </picker>
              </view>
              <view class="family-note">付款人与消费归属可以不同；公共和多人消费按记录人展示。</view>
            </block>
          </view>
          <tl-record-form quick-entry="{{!isEditing}}" entry-visible="{{!!categoryId}}" note-focused="{{noteFocused}}" saving="{{saving}}" bind:submit="saveAndLeave" bind:submitcontinue="saveAndContinue" type="{{type}}" amount="{{amount}}" amount-result="{{amountResult}}" show-amount-result="{{showAmountResult}}" quick-amounts="{{quickAmounts}}" ledger-name="{{ledgerName}}" accounts="{{accounts}}" account-index="{{accountIndex}}" date="{{date}}" note="{{note}}" tag-input="{{tagInput}}" tags="{{tags}}" bind:amountinput="onAmountInput" bind:quickamount="setQuickAmount" bind:accountchange="onAccountChange" bind:datechange="onDateChange" bind:noteinput="onNoteInput" bind:taginput="onTagInput" bind:addtag="addTag" bind:removetag="removeTag" bind:keypadchange="onKeypadChange">
            <view wx:if="{{!isEditing && categoryId}}" class="entry-panel-info">
              <view class="entry-panel-heading">
                <view class="entry-panel-category-pill {{selectedChipClass}}">
                  <tl-icon name="{{categoryIcon}}" size="28" color="{{selectedIconColor || '#f0442f'}}">
                  </tl-icon>
                  <text class="entry-panel-category">{{categoryHeading}}</text>
                </view>
                <view class="entry-panel-amount">
                  ¥{{amount || '0.00'}}
                  <text wx:if="{{showAmountResult && amountResult}}" class="entry-panel-result">= ¥{{amountResult}}</text>
                </view>
              </view>
              <view class="entry-clear" bindtap="clearEntryAmount">清空金额</view>
              <input class="entry-panel-note" value="{{note}}" maxlength="100" adjust-position="{{true}}" confirm-type="done" bindinput="onNoteInput" bindfocus="onNoteFocus" bindblur="onNoteBlur" placeholder="添加备注" />
              <view class="entry-panel-props">
                <picker mode="date" value="{{date}}" bindchange="onDateChange">
                  <view class="entry-panel-chip">{{date}}</view>
                </picker>
                <picker mode="selector" range="{{accounts}}" value="{{accountIndex}}" bindchange="onAccountChange">
                  <view class="entry-panel-chip">{{accounts[accountIndex] || '选择账户'}}</view>
                </picker>
              </view>
              <view wx:if="{{familyEnabled && type === 'expense'}}" class="entry-family">
                <view wx:if="{{familyLoading}}" class="family-note">正在同步家庭成员…</view>
                <view wx:elif="{{familyError}}" class="family-note">
                  成员信息加载失败
                  <tl-button variant="text" size="small" bind:tap="retryFamilyContext">重试</tl-button>
                </view>
                <block wx:else>
                  <picker mode="selector" range="{{familyMembers}}" range-key="nickName" value="{{familyPayerIndex}}" bindchange="changeFamilyPayer">
                    <view class="entry-family-row">
                      <text>付款人</text>
                      <text>{{familyMembers[familyPayerIndex].nickName}} ▾</text>
                    </view>
                  </picker>
                  <picker mode="selector" range="{{familyKinds}}" range-key="label" value="{{familyKindIndex}}" bindchange="changeFamilyKind">
                    <view class="entry-family-row">
                      <text>消费归属</text>
                      <text>{{familyKinds[familyKindIndex].label}} ▾</text>
                    </view>
                  </picker>
                  <picker wx:if="{{familyKinds[familyKindIndex].value === 'personal'}}" mode="selector" range="{{familyConsumers}}" range-key="nickName" value="{{familyConsumerIndex}}" bindchange="changeFamilyConsumer">
                    <view class="entry-family-row">
                      <text>消费成员</text>
                      <text>{{familyConsumers[familyConsumerIndex].nickName || '请选择'}} ▾</text>
                    </view>
                  </picker>
                </block>
              </view>
            </view>
          </tl-record-form>
          <view wx:if="{{isEditing}}" class="record-timestamps">
            <text wx:if="{{sourceText}}">来源：{{sourceText}}</text>
            <text wx:if="{{sourceTransactionId}}">来源交易号：{{sourceTransactionId}}</text>
            <text wx:if="{{importBatchId}}">导入批次：{{importBatchId}}</text>
            <text wx:if="{{createdDate}}">创建于：{{createdDate}}</text>
            <text wx:if="{{updatedDate}}">编辑于：{{updatedDate}}</text>
          </view>
        </block>
      </view>
    </scroll-view>
  </tl-container>
  <tl-page-actions wx:if="{{isEditing && !readonly && !keypadOpen && !recordLoading && !recordLoadError && !familyLoading && !familyError}}">
    <view class="record-actions {{isEditing ? 'has-delete' : ''}}">
      <tl-button wx:if="{{isEditing}}" variant="danger" block="{{true}}" loading="{{deleting}}" loading-text="删除中..." disabled="{{saving}}" bind:tap="deleteRecord">删除记录</tl-button>
      <block wx:if="{{isEditing}}">
        <tl-button block="{{true}}" loading="{{saving}}" loading-text="保存中..." disabled="{{deleting || !canSave}}" bind:tap="saveAndLeave">保存记录</tl-button>
      </block>
    </view>
  </tl-page-actions>
</view>
