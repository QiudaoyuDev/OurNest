.selected-card,
.selected-left {
  display: flex;
  align-items: center;
}

.selected-card {
  justify-content: space-between;
  margin-bottom: 22rpx;
  padding: 24rpx;
}

.selected-left {
  min-width: 0;
  gap: 14rpx;
}

.type-badge {
  height: 54rpx;
  padding: 0 16rpx;
  border-radius: var(--tl-radius-pill);
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.type-badge.expense {
  color: var(--tl-color-primary);
  background: var(--tl-color-primary-soft);
}

.type-badge.income {
  color: var(--tl-color-income);
  background: var(--tl-color-income-soft);
}

.selected-icon {
  width: 74rpx;
  height: 74rpx;
  border-radius: var(--tl-radius-md);
  flex: 0 0 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tl-color-primary-soft);
}

.selected-icon.income {
  background: var(--tl-color-income-soft);
}

.selected-text {
  min-width: 0;
}

.selected-name {
  max-width: 360rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.selected-meta {
  max-width: 360rpx;
  margin-top: 6rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.change-link {
  color: var(--tl-color-primary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  flex: 0 0 auto;
}

.record-timestamps {
  margin: 18rpx 16rpx 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-semibold);
  line-height: 32rpx;
  text-align: center;
}

.record-actions {
  display: grid;
  width: 100%;
  grid-template-columns: 1fr;
  gap: var(--tl-space-sm);
}

.record-actions.has-delete {
  grid-template-columns: 220rpx minmax(0, 1fr);
}

.record-actions:not(.has-delete) {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.family-card {
  padding: 24rpx;
  margin-bottom: 22rpx;
}
.family-title {
  color: var(--tl-color-text);
  font-weight: var(--tl-font-weight-bold);
}
.family-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--tl-color-border-warm);
  color: var(--tl-color-text-secondary);
}
.family-note {
  margin-top: 12rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

/* 快速记账核心看板 */
.entry-dashboard {
  padding: var(--tl-space-md);
  margin-bottom: var(--tl-space-sm);
  background: var(--tl-color-surface);
}

.type-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--tl-space-sm);
}

.dashboard-amount-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: var(--tl-space-sm) 0;
  gap: var(--tl-space-xs);
}

.dashboard-currency {
  font-size: var(--tl-font-size-2xl);
  font-weight: var(--tl-font-weight-bold);
  color: var(--tl-color-primary);
}

.dashboard-amount-value {
  font-size: var(--tl-font-data-xl);
  font-weight: var(--tl-font-weight-bold);
  color: var(--tl-color-text);
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}

.dashboard-amount-value.is-placeholder {
  color: var(--tl-color-text-tertiary);
}

.dashboard-amount-result {
  margin-left: var(--tl-space-xs);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  color: var(--tl-color-text-tertiary);
}

/* 分类引导胶囊 */
.category-pill-row {
  display: flex;
  justify-content: center;
  margin-bottom: var(--tl-space-sm);
}

.category-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 24rpx;
  border-radius: var(--tl-radius-pill);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  transition: all var(--tl-duration-fast) var(--tl-easing-standard);
}

.category-pill--empty {
  background: var(--tl-color-warning-soft);
  border: 2rpx dashed var(--tl-color-warning);
  color: var(--tl-color-warning);
}

.category-pill--selected {
  background: var(--tl-color-primary-soft);
  border: var(--tl-border-width) solid var(--tl-color-border-warm);
  color: var(--tl-color-primary);
}

/* 属性药丸行 */
.dashboard-props {
  display: flex;
  align-items: center;
  gap: var(--tl-space-xs);
  padding-top: var(--tl-space-xs);
  border-top: var(--tl-border-width) solid var(--tl-color-border-divider);
}

.prop-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: var(--tl-radius-pill);
  background: var(--tl-palette-warm-100);
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-medium);
}

.prop-chip--note {
  flex: 1;
  min-width: 0;
}

.prop-note-input {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-caption);
}

.prop-note-placeholder {
  color: var(--tl-color-text-tertiary);
}

/* 分类受控高度卡片 */
.category-section {
  padding: var(--tl-space-sm) var(--tl-space-md);
  margin-bottom: var(--tl-space-sm);
  background: var(--tl-color-surface);
}

.category-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--tl-space-xs);
}

.category-heading-title {
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.category-tree-scroll {
  height: 280rpx;
  max-height: 280rpx;
}
