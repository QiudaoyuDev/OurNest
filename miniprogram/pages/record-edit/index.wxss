.edit-page--detail {
  background: var(--tl-color-surface);
}

.detail-category {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 36rpx 0 12rpx;
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
}

.detail-category-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  flex: 1;
}

.detail-category-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--tl-radius-xs);
}

.detail-category-label {
  min-width: 0;
  overflow-wrap: anywhere;
}

/* 仅作用于编辑明细；快捷记账继续使用公共表单默认样式。 */
.edit-page--detail .tl-record-form {
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.edit-page--detail .tl-record-form__amount {
  justify-content: flex-start;
  padding: 0 0 26rpx;
}

.edit-page--detail .tl-record-form__amount text,
.edit-page--detail .tl-record-form__amount-value {
  height: auto;
  padding: 0;
  color: var(--tl-color-primary);
  font-size: var(--tl-font-data-xl);
  line-height: 1.3;
  text-align: left;
}

.edit-page--detail .tl-record-form__amount-value {
  flex: 0 1 auto;
}

.edit-page--income .tl-record-form__amount text,
.edit-page--income .tl-record-form__amount-value {
  color: var(--tl-color-income);
}

.edit-page--detail .tl-record-form__field,
.edit-page--detail .tl-record-form__tags {
  border-top: 0;
  border-bottom: var(--tl-border-width) solid var(--tl-color-divider-warm);
}

.edit-page--detail .family-card {
  padding: 28rpx 0 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.selected-card,
.selected-left {
  display: flex;
  align-items: center;
}

.selected-card {
  justify-content: space-between;
  margin-bottom: 22rpx;
  padding: 24rpx;
}

.selected-left {
  min-width: 0;
  gap: 14rpx;
}

.type-badge {
  height: 54rpx;
  padding: 0 16rpx;
  border-radius: var(--tl-radius-pill);
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-bold);
}

.type-badge.expense {
  color: var(--tl-color-primary-ink);
  background: var(--tl-color-primary-soft);
}

.type-badge.income {
  color: var(--tl-color-income);
  background: var(--tl-color-income-soft);
}

.selected-icon {
  width: 74rpx;
  height: 74rpx;
  border-radius: var(--tl-radius-md);
  flex: 0 0 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tl-color-primary-soft);
}

.selected-icon.income {
  background: var(--tl-color-income-soft);
}

.selected-text {
  min-width: 0;
}

.selected-name {
  max-width: 360rpx;
  color: var(--tl-color-text);
  font-size: var(--tl-font-heading);
  font-weight: var(--tl-font-weight-bold);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.selected-meta {
  max-width: 360rpx;
  margin-top: 6rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.change-link {
  color: var(--tl-color-primary-ink);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
  flex: 0 0 auto;
}

.record-timestamps {
  margin: 28rpx 0 0;
  padding: 24rpx 0 0;
  border-top: var(--tl-border-width) solid var(--tl-color-divider-warm);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
  font-weight: var(--tl-font-weight-semibold);
  line-height: 36rpx;
  text-align: left;
  overflow-wrap: anywhere;
}

.record-timestamps__dates {
  display: flex;
  flex-wrap: wrap;
  column-gap: 24rpx;
  row-gap: 6rpx;
}

.record-timestamps__date {
  white-space: nowrap;
  flex: 0 0 auto;
}

.record-actions {
  display: grid;
  width: 100%;
  grid-template-columns: 1fr;
  gap: var(--tl-space-sm);
}

.record-actions.has-delete {
  grid-template-columns: 220rpx minmax(0, 1fr);
}

.record-actions:not(.has-delete) {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.family-card {
  padding: 24rpx;
  margin-bottom: 22rpx;
}
.family-title {
  color: var(--tl-color-text);
  font-weight: var(--tl-font-weight-bold);
}
.family-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--tl-color-border-warm);
  color: var(--tl-color-text-secondary);
}
.family-note {
  margin-top: 12rpx;
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

/* 快速记账核心看板 */
.entry-dashboard {
  padding: var(--tl-space-md);
  margin-bottom: var(--tl-space-sm);
  background: var(--tl-color-surface);
}

.type-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--tl-space-sm);
}

/* 分类受控高度卡片 */
.category-section {
  padding: var(--tl-space-sm) var(--tl-space-md);
  margin-bottom: var(--tl-space-sm);
  background: var(--tl-color-surface);
}

.category-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--tl-space-xs);
}

.category-heading-title {
  flex: 0 0 auto;
  white-space: nowrap;
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-bold);
}

.category-tree-scroll {
  height: 55vh;
}

.category-tree-scroll--selected {
  height: 20vh;
}

.entry-panel-info {
  margin-bottom: var(--tl-space-sm);
}

.entry-panel-card,
.entry-family {
  padding: var(--tl-space-sm);
  margin-bottom: var(--tl-space-sm);
  border: var(--tl-border-width) solid var(--tl-color-divider-warm);
  border-radius: var(--tl-radius-control);
  background: var(--tl-color-surface);
}

.entry-panel-heading,
.entry-amount-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--tl-space-sm);
  min-width: 0;
}

.entry-panel-category-pill {
  display: flex;
  align-items: center;
  gap: var(--tl-space-xs);
  min-width: 0;
  color: var(--tl-color-text);
}

.entry-panel-category {
  min-width: 0;
  overflow-wrap: anywhere;
  font-size: var(--tl-font-body-sm);
  font-weight: var(--tl-font-weight-semibold);
}

.entry-change,
.entry-clear {
  flex: 0 0 auto;
  padding: 16rpx 8rpx;
  color: var(--tl-color-primary-ink);
  font-size: var(--tl-font-body-sm);
}

.entry-amount-row {
  align-items: flex-end;
  margin-top: var(--tl-space-sm);
}

.entry-panel-amount {
  min-width: 0;
  color: var(--tl-color-text);
  font-size: var(--tl-font-data-lg);
  line-height: 1.25;
  font-weight: var(--tl-font-weight-bold);
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.entry-panel-result {
  margin-top: var(--tl-space-xs);
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  overflow-wrap: anywhere;
}

.entry-field-label {
  color: var(--tl-color-text-secondary);
  font-size: var(--tl-font-body-sm);
  line-height: 1.5;
}

.entry-optional {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}

.entry-panel-note {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 var(--tl-space-sm);
  margin-top: var(--tl-space-xs);
  border: var(--tl-border-width) solid var(--tl-color-tab-divider);
  border-radius: var(--tl-radius-control);
  background: var(--tl-color-surface-muted);
  color: var(--tl-color-text);
  font-size: var(--tl-font-body);
}

.entry-panel-props {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--tl-space-sm);
  margin-top: var(--tl-space-sm);
}

.entry-field {
  min-width: 0;
}

.entry-panel-chip,
.entry-family-row {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--tl-space-xs);
  min-width: 0;
  min-height: 88rpx;
  padding: 12rpx var(--tl-space-sm);
  margin-top: var(--tl-space-xs);
  border: var(--tl-border-width) solid var(--tl-color-tab-divider);
  border-radius: var(--tl-radius-control);
  color: var(--tl-color-text);
  background: var(--tl-color-surface);
  font-size: var(--tl-font-body-sm);
  overflow-wrap: anywhere;
  word-break: break-all;
}

.entry-arrow {
  flex: 0 0 auto;
  color: var(--tl-color-primary-ink);
  font-size: var(--tl-font-heading);
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: var(--tl-space-xs);
}
.category-grid-item {
  display: flex;
  min-width: 0;
  min-height: 120rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border: var(--tl-border-width) solid transparent;
  border-radius: var(--tl-radius-md);
  color: var(--tl-color-text);
  font-size: var(--tl-font-caption);
  transition:
    transform var(--tl-duration-fast) cubic-bezier(0.34, 1.56, 0.64, 1),
    border-color var(--tl-duration-fast) ease,
    background var(--tl-duration-fast) ease;
}
.category-grid-item:active {
  transform: scale(0.92);
}
.category-grid-item.is-selected {
  border-color: var(--tl-color-primary);
  background: var(--tl-color-primary-soft);
  color: var(--tl-color-primary-ink);
  font-weight: var(--tl-font-weight-bold);
}
.category-grid-icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: var(--tl-radius-md);
  background: var(--tl-palette-warm-100);
  transition: transform var(--tl-duration-fast) cubic-bezier(0.34, 1.56, 0.64, 1);
}
.category-grid-item.is-selected .category-grid-icon {
  transform: scale(1.08);
}
.category-grid-name,
.category-grid-parent {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.category-grid-parent {
  color: var(--tl-color-text-tertiary);
  font-size: var(--tl-font-caption);
}
.entry-family {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--tl-space-sm);
}

.entry-family picker {
  min-width: 0;
}

.entry-family .family-note {
  grid-column: 1 / -1;
}
